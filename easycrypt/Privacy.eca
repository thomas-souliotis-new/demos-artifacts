(* -------------------------------------------------------------------- *)
(* P-DEMOS, Theorem 3 (voter privacy and receipt-freeness): the core of *)
(* the reduction of Appendix C, machine-checked for a fixed instance.    *)
(*                                                                      *)
(* Paper: security.tex, Theorem "Voter privacy and receipt-freeness"    *)
(*        (thm:privacy); proof in appendix.tex, Appendix C.             *)
(*                                                                      *)
(* Instance and simplifications (see README.md):                        *)
(*  - n = 2 ballots, m = 2 candidates, matrix mode, phi = 1;            *)
(*  - non-adaptive corruption: the adversary fixes the corrupted set    *)
(*    before Setup, and makes all its voting choices in one round;      *)
(*  - vote codes are identified with the BB positions they point to;    *)
(*  - one Sigma-protocol instance (kappa = 1), modelled as an abstract  *)
(*    perfect special-HVZK functionality;                               *)
(*  - every voter casts (no abstention).                                *)
(* -------------------------------------------------------------------- *)
require import AllCore List Distr DBool DInterval DProd StdBigop StdOrder.
(*---*) import Biased.
require import DiffieHellman.
import DDH G GP FD GP.ZModE.

(* -------------------------------------------------------------------- *)
(* Abstract Sigma-protocol for "E commits to an element of X".          *)
(* A statement is (ck, E); a witness is (value, randomness).            *)
type prand, fmsg, resp, chal.

op dprand : prand distr.
axiom dprand_ll   : is_lossless dprand.
axiom dprand_funi : is_funiform dprand.

op commitP : group * (group * group) -> exp * exp -> prand -> fmsg.
op respond : group * (group * group) -> exp * exp -> prand -> chal -> resp.
op simul   : group * (group * group) -> chal -> prand -> fmsg * resp.

(* Perfect special HVZK, in the form satisfied by the disjunctive       *)
(* Chaum-Pedersen protocol: for a true statement, the simulator's coins *)
(* are a bijective re-parametrisation of the prover's coins under which *)
(* the two transcripts coincide, for every challenge e.                 *)
op sbij  : group * (group * group) -> exp * exp -> chal -> prand -> prand.
op sbiji : group * (group * group) -> exp * exp -> chal -> prand -> prand.
axiom sbijK  st w e t : sbiji st w e (sbij st w e t) = t.
axiom sbijiK st w e t : sbij st w e (sbiji st w e t) = t.

(* The challenge is extracted from the two voters' coins.               *)
op chal_of : bool -> bool -> chal.

(* -------------------------------------------------------------------- *)
(* Encoding: candidate j in {0, 1} is encoded as x^j.                   *)
op xx : exp.
op enc (j : int) : exp = if j = 0 then one else xx.
op S : exp = one + xx.
op two : exp = one + one.
op cn : exp = S * inv two.      (* the neutral value c = S * m^-1 *)

(* Lifted ElGamal commitments.                                          *)
type com = group * group.
op com (h : group) (v r : exp) : com = (g ^ r, g ^ v * h ^ r).
op cmul (c d : com) : com = (c.`1 * d.`1, c.`2 * d.`2).
op cexp (c : com) (k : exp) : com = (c.`1 ^ k, c.`2 ^ k).

op valid (st : group * com) (w : exp * exp) =
  st.`2 = com st.`1 w.`1 w.`2 /\ (w.`1 = one \/ w.`1 = xx).

axiom hvzk st w e t :
  valid st w => simul st e (sbij st w e t) = (commitP st w t, respond st w t e).

(* -------------------------------------------------------------------- *)
(* Permutations of {0, 1} are booleans (true = the swap).              *)
op app (p : bool) (i : int) : int = if p then 1 - i else i.

(* Composition of permutations of {0, 1}: exclusive or.                *)
op (^^) (p q : bool) : bool = p <> q.

op pget (x : 'a * 'a) (i : int) : 'a = if i = 0 then x.`1 else x.`2.

(* Value at BB position p of a part with permutation pi.  Candidate j   *)
(* sits at position app pi j, so position p holds candidate app pi p.   *)
op vpos (pi : bool) (p : int) : exp = enc (app pi p).

(* -------------------------------------------------------------------- *)
(* Ballot parts.                                                        *)
(* Public part: (E_0, E_1, first message 0, first message 1, R).        *)
type ppub = com * com * fmsg * fmsg * exp.
(* Secret part: (pi, randomness at positions 0/1, responses as a        *)
(* function of the challenge).                                          *)
type psec = bool * (exp * exp) * (chal -> resp * resp).

op hE (h : group) (pi : bool) (r : exp * exp) (p : int) : com =
  com h (vpos pi p) (pget r p).

(* Honest part, generated by the EA.                                    *)
module PartH = {
  proc gen(h : group, pi : bool) : ppub * psec = {
    var r, t, e0, e1;

    r  <$ dt `*` dt;
    t  <$ dprand `*` dprand;
    e0 <- hE h pi r 0;
    e1 <- hE h pi r 1;
    return ((e0, e1,
             commitP (h, e0) (vpos pi 0, r.`1) t.`1,
             commitP (h, e1) (vpos pi 1, r.`2) t.`2,
             r.`1 + r.`2),
            (pi, r, fun e => (respond (h, e0) (vpos pi 0, r.`1) t.`1 e,
                              respond (h, e1) (vpos pi 1, r.`2) t.`2 e)));
  }
}.

(* Embedded part, generated by the reduction:                          *)
(*   E = Com(u; s) (.) C^(v - u),                                        *)
(* with simulated proofs for the guessed challenge es.                  *)
module PartE = {
  proc gen(h : group, cc : com, pi : bool, u : exp * exp, es : chal) : ppub * psec = {
    var s, sr, e0, e1, z0, z1;

    s  <$ dt `*` dt;
    sr <$ dprand `*` dprand;
    e0 <- cmul (com h u.`1 s.`1) (cexp cc (vpos pi 0 - u.`1));
    e1 <- cmul (com h u.`2 s.`2) (cexp cc (vpos pi 1 - u.`2));
    z0 <- simul (h, e0) es sr.`1;
    z1 <- simul (h, e1) es sr.`2;
    return ((e0, e1, z0.`1, z1.`1, s.`1 + s.`2),
            (pi, s, fun (_ : chal) => (z0.`2, z1.`2)));
  }
}.

(* -------------------------------------------------------------------- *)
(* The privacy game G_priv, for n = 2 and m = 2.                        *)
type pub_t   = group * (ppub * ppub) * (ppub * ppub).
(* What the tally reveals about one cast ballot: coin, psi (rank ->     *)
(* position, as a permutation), the opened audit part (pi, randomness),*)
(* and the responses of the cast part.                                  *)
type tinfo   = bool * bool * (bool * (exp * exp)) * (resp * resp).
type agg_t   = (exp * exp) * (exp * exp).
type view_t  = bool * bool.         (* shown paper ballot: pi of parts 0, 1 *)
type choice  = bool * bool.

module type PAdv = {
  proc corrupt() : bool * bool
  proc choose(pub : pub_t, cb0 : (bool * bool) option, cb1 : (bool * bool) option)
    : choice * choice
  proc guess(t0 : tinfo, t1 : tinfo, agg : agg_t, v0 : view_t, v1 : view_t) : bool
}.

(* The adversary's choice for voter l: an honest voter gets the pair    *)
(* (omega^0, omega^1); a corrupted voter submits (coin, ranking).        *)
op omega (b : bool) (c : bool) (ch : choice) : bool =
  if c then ch.`2 else (if b then ch.`2 else ch.`1).
op ccoin (c : bool) (ch : choice) (a : bool) : bool = if c then ch.`1 else a.

(* Matrix result N for two cast rankings: N_{i,j} = #{l : w_l(i) = j}. *)
type mat = (int * int) * (int * int).
op b2n (x : bool) : int = if x then 1 else 0.
op nmat (w0 w1 : bool) : mat =
  ((b2n (!w0) + b2n (!w1), b2n w0 + b2n w1), (b2n w0 + b2n w1, b2n (!w0) + b2n (!w1))).

(* Side conditions: at most phi = 1 corrupted voter, and equal results *)
(* on the honest voters for b = 0 and b = 1.                            *)
op hcnt (corr : bool * bool) (ch : choice * choice) (b : bool) : int =
  (if corr.`1 then 0 else b2n (omega b false ch.`1))
  + (if corr.`2 then 0 else b2n (omega b false ch.`2)).
op sidec (corr : bool * bool) (ch : choice * choice) : bool =
  !(corr.`1 /\ corr.`2) /\ hcnt corr ch false = hcnt corr ch true.

(* Tally data of one ballot, from its cast and audit secrets.           *)
op tinfo_of (ca : bool) (psi : bool) (kc ka : psec) (e : chal) : tinfo =
  (ca, psi, (ka.`1, ka.`2), kc.`3 e).

(* The voter's view returned to the adversary: the cast part is shown  *)
(* with the codes of psi next to omega^0 (for b = 0 this is the real   *)
(* paper ballot, for b = 1 it is the simulator S); the audit part is    *)
(* unchanged.  Corrupted voters get no view.                            *)
op view_of (c : bool) (ca : bool) (psi : bool) (w0 : bool) (ka : psec) : view_t =
  if c then (false, false)
  else if ca then (ka.`1, psi ^^ w0) else (psi ^^ w0, ka.`1).

(* Randomness of the rank-i aggregate.                                  *)
op aggr (kc0 kc1 : psec) (psi0 psi1 : bool) (i : int) : exp =
  pget kc0.`2 (app psi0 i) + pget kc1.`2 (app psi1 i).

(* Outcome of a run: corruption, choices, cast coins, the final guess.  *)
type out_t = (bool * bool) * (choice * choice) * (bool * bool) * bool.

module GPriv (A : PAdv) = {
  proc body(b : bool) : out_t = {
    var corr, x, h, p00, p01, p10, p11, q00, q01, q10, q11, k00, k01, k10, k11;
    var ch, a0, a1, ca0, ca1, w0, w1, e, kc0, ka0, kc1, ka1, psi0, psi1, agg, bs;

    corr <@ A.corrupt();
    x <$ dt;
    h <- g ^ x;
    p00 <$ dbool; p01 <$ dbool; p10 <$ dbool; p11 <$ dbool;
    (q00, k00) <@ PartH.gen(h, p00);
    (q01, k01) <@ PartH.gen(h, p01);
    (q10, k10) <@ PartH.gen(h, p10);
    (q11, k11) <@ PartH.gen(h, p11);
    ch <@ A.choose((h, (q00, q01), (q10, q11)),
                   if corr.`1 then Some (p00, p01) else None,
                   if corr.`2 then Some (p10, p11) else None);
    (* an honest voter flips a fair coin; a corrupted one submits a part *)
    if (corr.`1) { ca0 <- ch.`1.`1; } else { a0 <$ dbool; ca0 <- a0; }
    if (corr.`2) { ca1 <- ch.`2.`1; } else { a1 <$ dbool; ca1 <- a1; }
    w0  <- omega b corr.`1 ch.`1;
    w1  <- omega b corr.`2 ch.`2;
    e   <- chal_of ca0 ca1;
    kc0 <- if ca0 then k01 else k00;  ka0 <- if ca0 then k00 else k01;
    kc1 <- if ca1 then k11 else k10;  ka1 <- if ca1 then k10 else k11;
    psi0 <- kc0.`1 ^^ w0;
    psi1 <- kc1.`1 ^^ w1;
    agg <- ((enc (app w0 0) + enc (app w1 0), aggr kc0 kc1 psi0 psi1 0),
            (enc (app w0 1) + enc (app w1 1), aggr kc0 kc1 psi0 psi1 1));
    bs <@ A.guess(tinfo_of ca0 psi0 kc0 ka0 e, tinfo_of ca1 psi1 kc1 ka1 e, agg,
                  view_of corr.`1 ca0 psi0 ch.`1.`1 ka0,
                  view_of corr.`2 ca1 psi1 ch.`2.`1 ka1);
    return (corr, ch, (ca0, ca1), bs);
  }

  proc main() : bool = {
    var b, o, r;

    b <$ dbool;
    o <@ body(b);
    if (sidec o.`1 o.`2) { r <- (o.`4 = b); } else { r <$ dbool; }
    return r;
  }
}.

(* -------------------------------------------------------------------- *)
(* The reduction B of Appendix C.                                        *)
(* Guessed result N* and the carrier values.                            *)
op dmat : mat distr = (dinter 0 2 `*` dinter 0 2) `*` (dinter 0 2 `*` dinter 0 2).

op Tstar (ns : mat) (i : int) : exp =
  inzmod (pget (pget ns i) 0) + inzmod (pget (pget ns i) 1) * xx.

(* N* is a possible result: all row and column sums equal n_c.          *)
op nc (ns : mat) : int = ns.`1.`1 + ns.`1.`2.
op validm (ns : mat) : bool =
     ns.`2.`1 + ns.`2.`2 = nc ns
  /\ ns.`1.`1 + ns.`2.`1 = nc ns
  /\ ns.`1.`2 + ns.`2.`2 = nc ns.

(* Carrier values t_i = T*_i - (n_c - 1) c.  When N* is not a possible   *)
(* result, B uses neutral values instead (Cont fails in that case, so  *)
(* B's output is a uniform bit either way).                             *)
op tvals (ns : mat) : exp * exp =
  if validm ns
  then (Tstar ns 0 - (inzmod (nc ns) - one) * cn, Tstar ns 1 - (inzmod (nc ns) - one) * cn)
  else (cn, cn).

(* Alternative values of the carrier's embedded part: position p holds  *)
(* t_i for the rank i routed to p, where tau = pi o omega*.             *)
op ucar (tau : bool) (tv : exp * exp) : exp * exp =
  (pget tv (app tau 0), pget tv (app tau 1)).

(* The artificial coin: 1 with probability 2^-(phi-k) (n-phi)/(n-k).    *)
op artp (corr : bool * bool) : real =
  if !corr.`1 /\ !corr.`2 then 1%r / 4%r else 1%r.

(* The event Cont.                                                      *)
op contf (b : bool) (corr : bool * bool) (ch : choice * choice) (g0 g1 : bool)
         (ls : int) (ws : bool) (ns : mat) (art : bool) : bool =
     sidec corr ch
  /\ (corr.`1 => ch.`1.`1 = g0) /\ (corr.`2 => ch.`2.`1 = g1)
  /\ !(pget corr ls)
  /\ omega b false (pget ch ls) = ws
  /\ nmat (omega b corr.`1 ch.`1) (omega b corr.`2 ch.`2) = ns
  /\ art.

module B (A : PAdv) = {
  proc body(b : bool, h : group, cc : com) : bool * bool = {
    var corr, g0, g1, ls, ns, pE0, pH0, pE1, pH1, ws, tv, u0, u1, es;
    var qE0, kE0, qH0, kH0, qE1, kE1, qH1, kH1, q00, q01, q10, q11, k00, k01, k10, k11;
    var ch, ca0, ca1, w0, w1, e, kc0, ka0, kc1, ka1, psi0, psi1, agg, bs, art;

    corr <@ A.corrupt();
    g0 <$ dbool; g1 <$ dbool;        (* honest coins / guessed corrupted coins *)
    ls <$ [0 .. 1];                  (* carrier *)
    ns <$ dmat;                      (* guessed result *)
    pE0 <$ dbool; pH0 <$ dbool; pE1 <$ dbool; pH1 <$ dbool;
    ws <$ dbool;                     (* guessed ranking of the carrier *)
    tv <- tvals ns;
    u0 <- if ls = 0 then ucar (pE0 ^^ ws) tv else (cn, cn);
    u1 <- if ls = 1 then ucar (pE1 ^^ ws) tv else (cn, cn);
    es <- chal_of g0 g1;
    (qE0, kE0) <@ PartE.gen(h, cc, pE0, u0, es);
    (qH0, kH0) <@ PartH.gen(h, pH0);
    (qE1, kE1) <@ PartE.gen(h, cc, pE1, u1, es);
    (qH1, kH1) <@ PartH.gen(h, pH1);
    (* part g_l of ballot l is the embedded one *)
    q00 <- if g0 then qH0 else qE0;  q01 <- if g0 then qE0 else qH0;
    k00 <- if g0 then kH0 else kE0;  k01 <- if g0 then kE0 else kH0;
    q10 <- if g1 then qH1 else qE1;  q11 <- if g1 then qE1 else qH1;
    k10 <- if g1 then kH1 else kE1;  k11 <- if g1 then kE1 else kH1;
    ch <@ A.choose((h, (q00, q01), (q10, q11)),
                   if corr.`1 then Some (k00.`1, k01.`1) else None,
                   if corr.`2 then Some (k10.`1, k11.`1) else None);
    ca0 <- ccoin corr.`1 ch.`1 g0;
    ca1 <- ccoin corr.`2 ch.`2 g1;
    w0  <- omega b corr.`1 ch.`1;
    w1  <- omega b corr.`2 ch.`2;
    e   <- chal_of ca0 ca1;
    kc0 <- if ca0 then k01 else k00;  ka0 <- if ca0 then k00 else k01;
    kc1 <- if ca1 then k11 else k10;  ka1 <- if ca1 then k10 else k11;
    psi0 <- kc0.`1 ^^ w0;
    psi1 <- kc1.`1 ^^ w1;
    (* aggregates opened to the guessed result *)
    agg <- ((Tstar ns 0, aggr kc0 kc1 psi0 psi1 0),
            (Tstar ns 1, aggr kc0 kc1 psi0 psi1 1));
    bs <@ A.guess(tinfo_of ca0 psi0 kc0 ka0 e, tinfo_of ca1 psi1 kc1 ka1 e, agg,
                  view_of corr.`1 ca0 psi0 ch.`1.`1 ka0,
                  view_of corr.`2 ca1 psi1 ch.`2.`1 ka1);
    art <$ dbiased (artp corr);
    return (contf b corr ch g0 g1 ls ws ns art, bs);
  }

  proc run(h : group, cc : com) : bool = {
    var b, cont, bs, r;

    b <$ dbool;
    (cont, bs) <@ body(b, h, cc);
    if (cont) { r <- (bs = b); } else { r <$ dbool; }
    return r;
  }
}.

(* IND-CPA of lifted ElGamal for the messages 0 and 1: C = Com_h(bt; rho). *)
op b2e (bt : bool) : exp = if bt then one else zero.

module CPA (A : PAdv) = {
  proc main(bt : bool) : bool = {
    var x, rho, r;

    x   <$ dt;
    rho <$ dt;
    r   <@ B(A).run(g ^ x, com (g ^ x) (b2e bt) rho);
    return r;
  }
}.

(* The DDH distinguisher built from B.                                  *)
module D (A : PAdv) : Adversary = {
  proc guess(gx gy gz : group) : bool = {
    var bt, r;

    bt <$ dbool;
    r    <@ B(A).run(gx, (gy, g ^ b2e bt * gz));
    return (r = bt);
  }
}.

(* -------------------------------------------------------------------- *)
(* Commitment algebra.                                                   *)
lemma cmul_com h v r v' r' :
  cmul (com h v r) (com h v' r') = com h (v + v') (r + r').
proof.
rewrite /cmul /com /= !expD; split => //.
by rewrite -!mulcA; congr; rewrite mulcC -mulcA; congr; rewrite mulcC.
qed.

lemma cexp_com h v r k : cexp (com h v r) k = com h (v * k) (r * k).
proof.
rewrite /cexp /com /= !expM; split => //.
have hm : forall (a c : group) (t : exp), (a * c) ^ t = a ^ t * c ^ t.
+ by move=> a c t; rewrite !expE G.expcM.
by rewrite hm.
qed.

(* -------------------------------------------------------------------- *)
(* Distributions of a part's coins.                                     *)
lemma dtt_funi : is_funiform (dt `*` dt).
proof. by apply dprod_funi; apply dt_funi. qed.

lemma dtt_fu : is_full (dt `*` dt).
proof. by rewrite dprod_fu; split; apply dt_fu. qed.

lemma dpp_funi : is_funiform (dprand `*` dprand).
proof. by apply dprod_funi; apply dprand_funi. qed.

lemma dpp_fu : is_full (dprand `*` dprand).
proof.
by rewrite dprod_fu; split; apply funi_ll_full; [apply dprand_funi | apply dprand_ll | apply dprand_funi | apply dprand_ll].
qed.

(* v - u at position p. *)
op dvu (pi : bool) (u : exp * exp) (p : int) : exp = vpos pi p - pget u p.

op shiftr (r : exp * exp) (rho : exp) (pi : bool) (u : exp * exp) : exp * exp =
  (r.`1 - rho * dvu pi u 0, r.`2 - rho * dvu pi u 1).

lemma valid_hE h pi r p : p = 0 \/ p = 1 =>
  valid (h, hE h pi r p) (vpos pi p, pget r p).
proof. by move=> hp; rewrite /valid /hE /vpos /enc /=; smt(). qed.

lemma embed_com h u s rho v bt :
  cmul (com h u s) (cexp (com h bt rho) (v - u)) = com h (u + bt * (v - u)) (s + rho * (v - u)).
proof. by rewrite cexp_com cmul_com. qed.

lemma embed1 h u s rho v :
  cmul (com h u s) (cexp (com h one rho) (v - u)) = com h v (s + rho * (v - u)).
proof. by rewrite embed_com; congr; ring. qed.

lemma embed0 h u s rho v :
  cmul (com h u s) (cexp (com h zero rho) (v - u)) = com h u (s + rho * (v - u)).
proof. by rewrite embed_com; congr; ring. qed.

lemma hvzk' st w e sr : valid st w =>
  simul st e sr = (commitP st w (sbiji st w e sr), respond st w (sbiji st w e sr) e).
proof. by move=> hv; rewrite -{1}(sbijiK st w e sr) hvzk. qed.

lemma embedE1 h pi r rho u p : p = 0 \/ p = 1 =>
    cmul (com h (pget u p) (pget (shiftr r rho pi u) p))
         (cexp (com h one rho) (vpos pi p - pget u p))
  = hE h pi r p.
proof.
move=> hp; rewrite embed1 /hE /shiftr /dvu /pget.
by case: hp => -> /=; congr; ring.
qed.

(* (a), per part: for beta = 1 an embedded part is an honest part.      *)
equiv partE_H (rho0 : exp) (pi0 : bool) (u0 : exp * exp) (es0 : chal) :
  PartE.gen ~ PartH.gen :
     ={h, pi} /\ pi{1} = pi0 /\ u{1} = u0 /\ es{1} = es0
  /\ cc{1} = com h{1} one rho0
  /\ dvu pi0 u0 0 + dvu pi0 u0 1 = zero
  ==>  res{1}.`1 = res{2}.`1
    /\ res{1}.`2.`1 = res{2}.`2.`1 /\ res{2}.`2.`1 = pi0
    /\ res{1}.`2.`2 = shiftr res{2}.`2.`2 rho0 pi0 u0
    /\ (forall e, res{1}.`2.`3 e = res{2}.`2.`3 es0).
proof.
proc.
seq 1 1 : (={h, pi} /\ pi{1} = pi0 /\ u{1} = u0 /\ es{1} = es0
           /\ cc{1} = com h{1} one rho0 /\ dvu pi0 u0 0 + dvu pi0 u0 1 = zero
           /\ s{1} = shiftr r{2} rho0 pi0 u0).
+ rnd (fun (s : exp * exp) => (s.`1 + rho0 * dvu pi0 u0 0, s.`2 + rho0 * dvu pi0 u0 1))
      (fun (r : exp * exp) => shiftr r rho0 pi0 u0).
  skip => &1 &2 hpre /=.
  split; 1: by case=> r1 r2 _; rewrite /shiftr /=; split; ring.
  move=> _ sL _.
  have hs : sL = shiftr (sL.`1 + rho0 * dvu pi0 u0 0, sL.`2 + rho0 * dvu pi0 u0 1) rho0 pi0 u0.
  + by case: sL => s1 s2; rewrite /shiftr /=; split; ring.
  by split; [exact hs | smt()].
wp.
rnd (fun (sr : prand * prand) =>
       (sbiji (h{2}, hE h{2} pi{2} r{2} 0) (vpos pi{2} 0, r{2}.`1) es0 sr.`1,
        sbiji (h{2}, hE h{2} pi{2} r{2} 1) (vpos pi{2} 1, r{2}.`2) es0 sr.`2))
    (fun (t : prand * prand) =>
       (sbij (h{2}, hE h{2} pi{2} r{2} 0) (vpos pi{2} 0, r{2}.`1) es0 t.`1,
        sbij (h{2}, hE h{2} pi{2} r{2} 1) (vpos pi{2} 1, r{2}.`2) es0 t.`2)).
skip => &1 &2 [#] hh hpi hpi0 hu hes hcc hsum hs /=.
have E0 : cmul (com h{1} u{1}.`1 s{1}.`1) (cexp cc{1} (vpos pi{1} 0 - u{1}.`1))
        = hE h{2} pi{2} r{2} 0.
+ by rewrite hcc hh hpi hs hu -hpi0 hpi -(embedE1 h{2} pi{2} r{2} rho0 u0 0).
have E1 : cmul (com h{1} u{1}.`2 s{1}.`2) (cexp cc{1} (vpos pi{1} 1 - u{1}.`2))
        = hE h{2} pi{2} r{2} 1.
+ by rewrite hcc hh hpi hs hu -hpi0 hpi -(embedE1 h{2} pi{2} r{2} rho0 u0 1).
split; 1: by case=> t1 t2 _ /=; rewrite !sbijK.
move=> _; split; 1: by move=> t _; apply dpp_funi.
move=> _ sr _; split; 1: by apply dpp_fu.
move=> _; split; 1: by case: sr => sr1 sr2 /=; rewrite !sbijiK.
move=> _; rewrite E0 E1 hh hes /=.
rewrite (hvzk' (h{2}, hE h{2} pi{2} r{2} 0) (vpos pi{2} 0, r{2}.`1)) 1:valid_hE //.
rewrite (hvzk' (h{2}, hE h{2} pi{2} r{2} 1) (vpos pi{2} 1, r{2}.`2)) 1:valid_hE //=.
split; 2: by rewrite hpi hs -hpi -hpi0.
rewrite hs /shiftr /=.
have -> : r{2}.`1 - rho0 * dvu pi0 u0 0 + (r{2}.`2 - rho0 * dvu pi0 u0 1)
        = r{2}.`1 + r{2}.`2 - rho0 * (dvu pi0 u0 0 + dvu pi0 u0 1) by ring.
by rewrite hsum; ring.
qed.

(* (b), per part: for beta = 0 an embedded part commits to u with fresh *)
(* randomness s' = s + rho (v - u), so its public data does not depend *)
(* on pi.  PartE0 generates it without pi; the randomness s used by the *)
(* tally is recovered later as s = s' - rho (v - u).                    *)
module PartE0 = {
  proc gen(h : group, u : exp * exp, es : chal) : ppub * psec = {
    var s', sr, e0, e1, z0, z1;

    s' <$ dt `*` dt;
    sr <$ dprand `*` dprand;
    e0 <- com h u.`1 s'.`1;
    e1 <- com h u.`2 s'.`2;
    z0 <- simul (h, e0) es sr.`1;
    z1 <- simul (h, e1) es sr.`2;
    return ((e0, e1, z0.`1, z1.`1, s'.`1 + s'.`2),
            (false, s', fun (_ : chal) => (z0.`2, z1.`2)));
  }
}.

equiv partE_E0 (rho0 : exp) (pi0 : bool) (u0 : exp * exp) :
  PartE.gen ~ PartE0.gen :
     ={h, u, es} /\ pi{1} = pi0 /\ u{1} = u0
  /\ cc{1} = com h{1} zero rho0
  /\ dvu pi0 u0 0 + dvu pi0 u0 1 = zero
  ==>  res{1}.`1 = res{2}.`1
    /\ res{1}.`2.`1 = pi0
    /\ res{1}.`2.`2 = shiftr res{2}.`2.`2 rho0 pi0 u0
    /\ (forall e, res{1}.`2.`3 e = res{2}.`2.`3 e).
proof.
proc; wp.
rnd.
rnd (fun (s : exp * exp) => (s.`1 + rho0 * dvu pi0 u0 0, s.`2 + rho0 * dvu pi0 u0 1))
    (fun (r : exp * exp) => shiftr r rho0 pi0 u0).
skip => &1 &2 hpre /=.
have [#] hh hu hes hpi hu0 hcc hsum : h{1} = h{2} /\ u{1} = u{2} /\ es{1} = es{2}
  /\ pi{1} = pi0 /\ u{1} = u0 /\ cc{1} = com h{1} zero rho0
  /\ dvu pi0 u0 0 + dvu pi0 u0 1 = zero by smt().
split; 1: by case=> r1 r2 _; rewrite /shiftr /=; split; ring.
move=> _ sL _.
have hs : sL = shiftr (sL.`1 + rho0 * dvu pi0 u0 0, sL.`2 + rho0 * dvu pi0 u0 1) rho0 pi0 u0.
+ by case: sL => s1 s2; rewrite /shiftr /=; split; ring.
split; 1: exact hs.
move=> _ sr _.
have E0 : cmul (com h{1} u{1}.`1 sL.`1) (cexp cc{1} (vpos pi{1} 0 - u{1}.`1))
        = com h{2} u{2}.`1 (sL.`1 + rho0 * dvu pi0 u0 0).
+ by rewrite hcc embed0 /dvu /pget /= hh hpi -hu hu0.
have E1 : cmul (com h{1} u{1}.`2 sL.`2) (cexp cc{1} (vpos pi{1} 1 - u{1}.`2))
        = com h{2} u{2}.`2 (sL.`2 + rho0 * dvu pi0 u0 1).
+ by rewrite hcc embed0 /dvu /pget /= hh hpi -hu hu0.
split; 1: by apply dpp_fu.
move=> _; rewrite E0 E1 hh hes hpi /=; split; 2: exact hs.
have -> : sL.`1 + sL.`2 = sL.`1 + rho0 * dvu pi0 u0 0 + (sL.`2 + rho0 * dvu pi0 u0 1)
                          - rho0 * (dvu pi0 u0 0 + dvu pi0 u0 1) by ring.
by rewrite hsum; ring.
qed.

(* -------------------------------------------------------------------- *)
(* Arithmetic facts used by the reduction.                              *)
lemma app_inv p i : i = 0 \/ i = 1 => app p (app p i) = i.
proof. by rewrite /app; smt(). qed.

lemma app_xor p q i : i = 0 \/ i = 1 => app (p ^^ q) i = app p (app q i).
proof. by rewrite /app /(^^); smt(). qed.

lemma app_rg p i : i = 0 \/ i = 1 => app p i = 0 \/ app p i = 1.
proof. by rewrite /app; smt(). qed.

lemma enc_sum p : enc (app p 0) + enc (app p 1) = S.
proof. by rewrite /enc /app /S; case: p => /=; smt(addrC). qed.

lemma two_cn : two <> zero => cn + cn = S.
proof.
move=> h2; rewrite /cn.
have -> : S * inv two + S * inv two = S * (two * inv two) by rewrite /two; ring.
by rewrite ZModpField.mulrV ?ZModpField.unitfP // ZModpField.mulr1.
qed.

lemma inzmod2 : inzmod 2 = two.
proof. by rewrite /two (: 2 = 1 + 1) // inzmodD. qed.

lemma tv_sum ns : two <> zero => (tvals ns).`1 + (tvals ns).`2 = S.
proof.
move=> h2; rewrite /tvals; case: (validm ns) => hv /=; last by rewrite two_cn.
move: hv; rewrite /validm /Tstar /pget /nc /= => -[h1 [h3 h4]].
have -> : inzmod ns.`1.`1 + inzmod ns.`1.`2 * xx - (inzmod (ns.`1.`1 + ns.`1.`2) - one) * cn
        + (inzmod ns.`2.`1 + inzmod ns.`2.`2 * xx - (inzmod (ns.`1.`1 + ns.`1.`2) - one) * cn)
        = inzmod (ns.`1.`1 + ns.`2.`1) + inzmod (ns.`1.`2 + ns.`2.`2) * xx
          - (inzmod (ns.`1.`1 + ns.`1.`2) - one) * (cn + cn).
+ by rewrite !inzmodD; ring.
by rewrite h3 h4 two_cn // /S; ring.
qed.

lemma dvu_sum_neutral pi : two <> zero => dvu pi (cn, cn) 0 + dvu pi (cn, cn) 1 = zero.
proof.
move=> h2; rewrite /dvu /vpos /pget /=.
have -> : enc (app pi 0) - cn + (enc (app pi 1) - cn) = (enc (app pi 0) + enc (app pi 1)) - (cn + cn) by ring.
by rewrite enc_sum two_cn // subrr.
qed.

lemma dvu_sum_car pi tau ns : two <> zero =>
  dvu pi (ucar tau (tvals ns)) 0 + dvu pi (ucar tau (tvals ns)) 1 = zero.
proof.
move=> h2; rewrite /dvu /vpos /ucar /pget /=.
have -> : enc (app pi 0) - (if app tau 0 = 0 then (tvals ns).`1 else (tvals ns).`2)
          + (enc (app pi 1) - (if app tau 1 = 0 then (tvals ns).`1 else (tvals ns).`2))
        = (enc (app pi 0) + enc (app pi 1))
          - ((tvals ns).`1 + (tvals ns).`2) by rewrite /app; case: tau => _ /=; ring.
by rewrite enc_sum tv_sum // subrr.
qed.

lemma Tstar_nmat w0 w1 i : i = 0 \/ i = 1 =>
  Tstar (nmat w0 w1) i = enc (app w0 i) + enc (app w1 i).
proof.
move=> hi; rewrite /Tstar /nmat /pget /enc /app /b2n.
have i0 : inzmod 0 = zero by done.
have i1 : inzmod 1 = one by done.
by case: hi => ->; case: w0 => hw0; case: w1 => hw1 /=;
  rewrite ?(hw0, hw1) /= ?i0 ?i1 ?inzmod2 /two; ring.
qed.

lemma validm_nmat w0 w1 : validm (nmat w0 w1) /\ nc (nmat w0 w1) = 2.
proof. by rewrite /validm /nmat /nc /b2n; case: w0; case: w1. qed.

lemma tvals_nmat w0 w1 i : i = 0 \/ i = 1 =>
  pget (tvals (nmat w0 w1)) i = Tstar (nmat w0 w1) i - cn.
proof.
move=> hi; have [hv hn] := validm_nmat w0 w1.
rewrite /tvals hv hn /= inzmod2 /two.
have -> : one + one - one = one by ring.
by case: hi => -> /=; rewrite /pget /= ZModpRing.mul1r.
qed.

lemma vpos_routed pi w i : i = 0 \/ i = 1 => vpos pi (app (pi ^^ w) i) = enc (app w i).
proof. by move=> hi; rewrite /vpos app_xor // app_inv // app_rg. qed.

(* At every rank, the routed real values minus the routed alternative  *)
(* values cancel when the guesses are right (the heart of Cont).       *)
op uof (l ls : int) (pi ws : bool) (ns : mat) : exp * exp =
  if ls = l then ucar (pi ^^ ws) (tvals ns) else (cn, cn).

lemma routed_zero pi0 pi1 w0 w1 ls ws i :
  two <> zero => i = 0 \/ i = 1 => ls = 0 \/ ls = 1 => pget (w0, w1) ls = ws =>
    dvu pi0 (uof 0 ls pi0 ws (nmat w0 w1)) (app (pi0 ^^ w0) i)
  + dvu pi1 (uof 1 ls pi1 ws (nmat w0 w1)) (app (pi1 ^^ w1) i) = zero.
proof.
move=> h2 hi hls hws; rewrite /dvu !vpos_routed //.
have hc : forall (p w : bool), pget (ucar (p ^^ ws) (tvals (nmat w0 w1))) (app (p ^^ w) i)
                             = pget (tvals (nmat w0 w1)) (app (ws ^^ w) i).
+ move=> p w; rewrite /ucar /pget /= /(^^) /app.
  by case: hi => ->; case: p; case: w; case: ws.
case: hls => ->>.
+ have <<- : w0 = ws by rewrite -hws.
  rewrite /uof /= hc (: w0 ^^ w0 = false) 1:/(^^) //.
  rewrite (: app false i = i) 1:/app // tvals_nmat // Tstar_nmat //.
  by rewrite /pget /=; ring.
have <<- : w1 = ws by rewrite -hws.
rewrite /uof /= hc (: w1 ^^ w1 = false) 1:/(^^) //.
rewrite (: app false i = i) 1:/app // tvals_nmat // Tstar_nmat //.
by rewrite /pget /=; ring.
qed.

lemma dvu_sum_uof l ls pi ws ns : two <> zero =>
  dvu pi (uof l ls pi ws ns) 0 + dvu pi (uof l ls pi ws ns) 1 = zero.
proof.
move=> h2; rewrite /uof; case: (ls = l) => _.
+ exact dvu_sum_car.
exact dvu_sum_neutral.
qed.

lemma ifif (c : bool) (x y : 'a) :
  (if c then (if c then x else y) else (if c then y else x)) = x.
proof. by case: c. qed.

lemma ifif2 (c : bool) (x y : 'a) :
  (if c then (if c then y else x) else (if c then x else y)) = y.
proof. by case: c. qed.

lemma aggr_shift (kc0 kc1 kc0' kc1' : psec) psi0 psi1 rho u0 u1 i :
  i = 0 \/ i = 1 =>
  kc0.`2 = shiftr kc0'.`2 rho kc0'.`1 u0 =>
  kc1.`2 = shiftr kc1'.`2 rho kc1'.`1 u1 =>
    aggr kc0 kc1 psi0 psi1 i
  = aggr kc0' kc1' psi0 psi1 i
    - rho * (dvu kc0'.`1 u0 (app psi0 i) + dvu kc1'.`1 u1 (app psi1 i)).
proof.
move=> hi e0 e1; rewrite /aggr e0 e1 /shiftr.
have h0 := app_rg psi0 i hi; have h1 := app_rg psi1 i hi.
by case: h0 => ->; case: h1 => -> /=; rewrite /pget /=; ring.
qed.

lemma pget_omega b (corr : bool * bool) (ch : choice * choice) ls :
  (ls = 0 \/ ls = 1) => !pget corr ls =>
  pget (omega b corr.`1 ch.`1, omega b corr.`2 ch.`2) ls = omega b false (pget ch ls).
proof. by case=> -> /=; rewrite /pget /= => ->. qed.

(* -------------------------------------------------------------------- *)
(* (a)  beta = 1.                                                        *)
(* B1 is the CPA game with beta = 1, up to B's final decision.          *)
module B1 (A : PAdv) = {
  proc body(b : bool) : bool * bool = {
    var x, rho, r;

    x   <$ dt;
    rho <$ dt;
    r   <@ B(A).body(b, g ^ x, com (g ^ x) one rho);
    return r;
  }
}.

(* RealG: the real game G_priv, run next to the guesses of B.  It is B  *)
(* with every embedded part replaced by an honest one and the true      *)
(* result in the aggregates.                                            *)
module RealG (A : PAdv) = {
  proc body(b : bool) : bool * bool = {
    var x, h, corr, g0, g1, ls, ns, pE0, pH0, pE1, pH1, ws;
    var qE0, kE0, qH0, kH0, qE1, kE1, qH1, kH1, q00, q01, q10, q11, k00, k01, k10, k11;
    var ch, ca0, ca1, w0, w1, e, kc0, ka0, kc1, ka1, psi0, psi1, agg, bs, art;

    x <$ dt;
    h <- g ^ x;
    corr <@ A.corrupt();
    g0 <$ dbool; g1 <$ dbool;
    ls <$ [0 .. 1];
    ns <$ dmat;
    pE0 <$ dbool; pH0 <$ dbool; pE1 <$ dbool; pH1 <$ dbool;
    ws <$ dbool;
    (qE0, kE0) <@ PartH.gen(h, pE0);
    (qH0, kH0) <@ PartH.gen(h, pH0);
    (qE1, kE1) <@ PartH.gen(h, pE1);
    (qH1, kH1) <@ PartH.gen(h, pH1);
    q00 <- if g0 then qH0 else qE0;  q01 <- if g0 then qE0 else qH0;
    k00 <- if g0 then kH0 else kE0;  k01 <- if g0 then kE0 else kH0;
    q10 <- if g1 then qH1 else qE1;  q11 <- if g1 then qE1 else qH1;
    k10 <- if g1 then kH1 else kE1;  k11 <- if g1 then kE1 else kH1;
    ch <@ A.choose((h, (q00, q01), (q10, q11)),
                   if corr.`1 then Some (k00.`1, k01.`1) else None,
                   if corr.`2 then Some (k10.`1, k11.`1) else None);
    ca0 <- ccoin corr.`1 ch.`1 g0;
    ca1 <- ccoin corr.`2 ch.`2 g1;
    w0  <- omega b corr.`1 ch.`1;
    w1  <- omega b corr.`2 ch.`2;
    e   <- chal_of ca0 ca1;
    kc0 <- if ca0 then k01 else k00;  ka0 <- if ca0 then k00 else k01;
    kc1 <- if ca1 then k11 else k10;  ka1 <- if ca1 then k10 else k11;
    psi0 <- kc0.`1 ^^ w0;
    psi1 <- kc1.`1 ^^ w1;
    agg <- ((enc (app w0 0) + enc (app w1 0), aggr kc0 kc1 psi0 psi1 0),
            (enc (app w0 1) + enc (app w1 1), aggr kc0 kc1 psi0 psi1 1));
    bs <@ A.guess(tinfo_of ca0 psi0 kc0 ka0 e, tinfo_of ca1 psi1 kc1 ka1 e, agg,
                  view_of corr.`1 ca0 psi0 ch.`1.`1 ka0,
                  view_of corr.`2 ca1 psi1 ch.`2.`1 ka1);
    art <$ dbiased (artp corr);
    return (contf b corr ch g0 g1 ls ws ns art, bs);
  }
}.

(* RealG2: as RealG, but every part is generated in place, so the setup *)
(* no longer depends on the coins g0, g1.                               *)
module RealG2 (A : PAdv) = {
  proc body(b : bool) : bool * bool = {
    var x, h, corr, g0, g1, ls, ns, p00, p01, p10, p11, ws;
    var q00, q01, q10, q11, k00, k01, k10, k11;
    var ch, ca0, ca1, w0, w1, e, kc0, ka0, kc1, ka1, psi0, psi1, agg, bs, art;

    x <$ dt;
    h <- g ^ x;
    corr <@ A.corrupt();
    g0 <$ dbool; g1 <$ dbool;
    ls <$ [0 .. 1];
    ns <$ dmat;
    p00 <$ dbool; p01 <$ dbool; p10 <$ dbool; p11 <$ dbool;
    ws <$ dbool;
    (q00, k00) <@ PartH.gen(h, p00);
    (q01, k01) <@ PartH.gen(h, p01);
    (q10, k10) <@ PartH.gen(h, p10);
    (q11, k11) <@ PartH.gen(h, p11);
    ch <@ A.choose((h, (q00, q01), (q10, q11)),
                   if corr.`1 then Some (k00.`1, k01.`1) else None,
                   if corr.`2 then Some (k10.`1, k11.`1) else None);
    if (corr.`1) { ca0 <- ch.`1.`1; } else { ca0 <- g0; }
    if (corr.`2) { ca1 <- ch.`2.`1; } else { ca1 <- g1; }
    w0  <- omega b corr.`1 ch.`1;
    w1  <- omega b corr.`2 ch.`2;
    e   <- chal_of ca0 ca1;
    kc0 <- if ca0 then k01 else k00;  ka0 <- if ca0 then k00 else k01;
    kc1 <- if ca1 then k11 else k10;  ka1 <- if ca1 then k10 else k11;
    psi0 <- kc0.`1 ^^ w0;
    psi1 <- kc1.`1 ^^ w1;
    agg <- ((enc (app w0 0) + enc (app w1 0), aggr kc0 kc1 psi0 psi1 0),
            (enc (app w0 1) + enc (app w1 1), aggr kc0 kc1 psi0 psi1 1));
    bs <@ A.guess(tinfo_of ca0 psi0 kc0 ka0 e, tinfo_of ca1 psi1 kc1 ka1 e, agg,
                  view_of corr.`1 ca0 psi0 ch.`1.`1 ka0,
                  view_of corr.`2 ca1 psi1 ch.`2.`1 ka1);
    art <$ dbiased (artp corr);
    return (contf b corr ch g0 g1 ls ws ns art, bs);
  }
}.

(* RealE: the real game G_priv, followed by B's guesses sampled at the  *)
(* very end, independently of everything the adversary did.             *)
module RealE (A : PAdv) = {
  proc body(b : bool) : bool * bool = {
    var o, gm0, gm1, ls, ns, ws, art;

    o   <@ GPriv(A).body(b);
    gm0 <$ dbool; gm1 <$ dbool;
    ls  <$ [0 .. 1];
    ns  <$ dmat;
    ws  <$ dbool;
    art <$ dbiased (artp o.`1);
    return (contf b o.`1 o.`2 gm0 gm1 ls ws ns art, o.`4);
  }
}.

(* For beta = 0: on Cont, the opened aggregate randomness is the sum of *)
(* the fresh s' at the routed positions, whatever pi and omega are.     *)
lemma aggr_K p0 p1 w0 w1 tau ls ns (s0 s1 : exp * exp) rho z0 z1 i :
  two <> zero => i = 0 \/ i = 1 => ls = 0 \/ ls = 1 =>
  pget (w0, w1) ls = pget (p0, p1) ls ^^ tau =>
  nmat w0 w1 = ns =>
    aggr (p0, shiftr s0 rho p0 (if ls = 0 then ucar tau (tvals ns) else (cn, cn)), z0)
         (p1, shiftr s1 rho p1 (if ls = 1 then ucar tau (tvals ns) else (cn, cn)), z1)
         (p0 ^^ w0) (p1 ^^ w1) i
  = pget s0 (app (p0 ^^ w0) i) + pget s1 (app (p1 ^^ w1) i).
proof.
move=> h2 hi hls hw hn.
have ws_def : tau = pget (p0, p1) ls ^^ pget (w0, w1) ls.
+ by rewrite hw /(^^); smt().
have hu0 : (if ls = 0 then ucar tau (tvals ns) else (cn, cn))
         = uof 0 ls p0 (pget (w0, w1) ls) ns.
+ by rewrite /uof ws_def; case: hls => -> //=; rewrite /pget /= /(^^); smt().
have hu1 : (if ls = 1 then ucar tau (tvals ns) else (cn, cn))
         = uof 1 ls p1 (pget (w0, w1) ls) ns.
+ by rewrite /uof ws_def; case: hls => -> //=; rewrite /pget /= /(^^); smt().
rewrite hu0 hu1 -hn.
rewrite (aggr_shift _ _ (p0, s0, z0) (p1, s1, z1) (p0 ^^ w0) (p1 ^^ w1) rho
           (uof 0 ls p0 (pget (w0, w1) ls) (nmat w0 w1))
           (uof 1 ls p1 (pget (w0, w1) ls) (nmat w0 w1)) i) //=.
by rewrite routed_zero // /aggr /=; ring.
qed.

lemma psi_flip (p q : bool) b c (ch : choice) :
  (if c then p else q ^^ (ch.`1 ^^ ch.`2)) ^^ omega (!b) c ch
  = (if c then p else q) ^^ omega b c ch.
proof. by rewrite /omega /(^^); case: c; case: b; smt(). qed.

lemma sidec_nmat b corr (ch : choice * choice) : sidec corr ch =>
  nmat (omega (!b) corr.`1 ch.`1) (omega (!b) corr.`2 ch.`2)
  = nmat (omega b corr.`1 ch.`1) (omega b corr.`2 ch.`2).
proof.
rewrite /sidec /hcnt /nmat /omega /b2n.
by case: corr => c0 c1; case: ch => x y; case: x => x0 x1; case: y => y0 y1;
   case: b; case: c0; case: c1; case: x0; case: x1; case: y0; case: y1.
qed.

lemma cont_flip b (corr : bool * bool) (ch : choice * choice) g0 g1 ls (ns : mat) a pc0 ph0 pc1 ph1 tau :
  ls = 0 \/ ls = 1 =>
    contf b corr ch g0 g1 ls
      (pget (if corr.`1 then pc0 else ph0, if corr.`2 then pc1 else ph1) ls ^^ tau) ns a
  = contf (!b) corr ch g0 g1 ls
      (pget (if corr.`1 then pc0 else ph0 ^^ (ch.`1.`1 ^^ ch.`1.`2),
             if corr.`2 then pc1 else ph1 ^^ (ch.`2.`1 ^^ ch.`2.`2)) ls ^^ tau) ns a.
proof.
move=> hls; rewrite /contf.
case: (sidec corr ch) => hsc //=.
rewrite (sidec_nmat b corr ch hsc).
case: (pget corr ls) => hc //=.
have -> : (omega (!b) false (pget ch ls)
           = pget (if corr.`1 then pc0 else ph0 ^^ (ch.`1.`1 ^^ ch.`1.`2),
                   if corr.`2 then pc1 else ph1 ^^ (ch.`2.`1 ^^ ch.`2.`2)) ls ^^ tau)
        = (omega b false (pget ch ls)
           = pget (if corr.`1 then pc0 else ph0, if corr.`2 then pc1 else ph1) ls ^^ tau).
+ case: hls hc => -> /=; rewrite /pget /= => hc; rewrite hc /= /omega /(^^);
  case: b; smt().
done.
qed.

(* -------------------------------------------------------------------- *)
(* (b)  beta = 0.                                                        *)
module B0 (A : PAdv) = {
  proc body(b : bool) : bool * bool = {
    var x, rho, r;

    x   <$ dt;
    rho <$ dt;
    r   <@ B(A).body(b, g ^ x, com (g ^ x) zero rho);
    return r;
  }
}.

(* B0L: B0 after the re-parametrisation of Appendix C.  Every embedded  *)
(* commitment is Com(u; s') with fresh s', the carrier's alternative    *)
(* values sit at positions tau = pi o omega*, and the permutation of an *)
(* honest voter's embedded part is sampled only after the adversary has *)
(* made its choices.                                                    *)
module B0L (A : PAdv) = {
  proc body(b : bool) : bool * bool = {
    var x, rho, h, cc, corr, g0, g1, ls, ns, pEc0, pH0, pEc1, pH1, tau, tv, u0, u1, es;
    var qE0, kF0, qH0, kH0, qE1, kF1, qH1, kH1, q00, q01, q10, q11;
    var ch, pEh0, pEh1, pE0, pE1, ws, kE0, kE1, k00, k01, k10, k11;
    var ca0, ca1, w0, w1, e, kc0, ka0, kc1, ka1, psi0, psi1, agg, bs, art;

    x   <$ dt;
    rho <$ dt;
    h   <- g ^ x;
    cc  <- com h zero rho;
    corr <@ A.corrupt();
    g0 <$ dbool; g1 <$ dbool;
    ls <$ [0 .. 1];
    ns <$ dmat;
    pEc0 <$ dbool; pH0 <$ dbool; pEc1 <$ dbool; pH1 <$ dbool;
    tau <$ dbool;
    tv <- tvals ns;
    u0 <- if ls = 0 then ucar tau tv else (cn, cn);
    u1 <- if ls = 1 then ucar tau tv else (cn, cn);
    es <- chal_of g0 g1;
    (qE0, kF0) <@ PartE0.gen(h, u0, es);
    (qH0, kH0) <@ PartH.gen(h, pH0);
    (qE1, kF1) <@ PartE0.gen(h, u1, es);
    (qH1, kH1) <@ PartH.gen(h, pH1);
    q00 <- if g0 then qH0 else qE0;  q01 <- if g0 then qE0 else qH0;
    q10 <- if g1 then qH1 else qE1;  q11 <- if g1 then qE1 else qH1;
    ch <@ A.choose((h, (q00, q01), (q10, q11)),
                   if corr.`1 then Some (if g0 then pH0 else pEc0, if g0 then pEc0 else pH0) else None,
                   if corr.`2 then Some (if g1 then pH1 else pEc1, if g1 then pEc1 else pH1) else None);
    pEh0 <$ dbool; pEh1 <$ dbool;
    pE0 <- if corr.`1 then pEc0 else pEh0;
    pE1 <- if corr.`2 then pEc1 else pEh1;
    ws  <- pget (pE0, pE1) ls ^^ tau;
    kE0 <- (pE0, shiftr kF0.`2 rho pE0 u0, kF0.`3);
    kE1 <- (pE1, shiftr kF1.`2 rho pE1 u1, kF1.`3);
    k00 <- if g0 then kH0 else kE0;  k01 <- if g0 then kE0 else kH0;
    k10 <- if g1 then kH1 else kE1;  k11 <- if g1 then kE1 else kH1;
    ca0 <- ccoin corr.`1 ch.`1 g0;
    ca1 <- ccoin corr.`2 ch.`2 g1;
    w0  <- omega b corr.`1 ch.`1;
    w1  <- omega b corr.`2 ch.`2;
    e   <- chal_of ca0 ca1;
    kc0 <- if ca0 then k01 else k00;  ka0 <- if ca0 then k00 else k01;
    kc1 <- if ca1 then k11 else k10;  ka1 <- if ca1 then k10 else k11;
    psi0 <- kc0.`1 ^^ w0;
    psi1 <- kc1.`1 ^^ w1;
    agg <- ((Tstar ns 0, aggr kc0 kc1 psi0 psi1 0),
            (Tstar ns 1, aggr kc0 kc1 psi0 psi1 1));
    bs <@ A.guess(tinfo_of ca0 psi0 kc0 ka0 e, tinfo_of ca1 psi1 kc1 ka1 e, agg,
                  view_of corr.`1 ca0 psi0 ch.`1.`1 ka0,
                  view_of corr.`2 ca1 psi1 ch.`2.`1 ka1);
    art <$ dbiased (artp corr);
    return (contf b corr ch g0 g1 ls ws ns art, bs);
  }
}.

(* B0E: B0L with the honest permutations sampled eagerly.             *)
module B0E (A : PAdv) = {
  proc body(b : bool) : bool * bool = {
    var x, rho, h, cc, corr, g0, g1, ls, ns, pEc0, pH0, pEc1, pH1, tau, tv, u0, u1, es;
    var qE0, kF0, qH0, kH0, qE1, kF1, qH1, kH1, q00, q01, q10, q11;
    var ch, pEh0, pEh1, pE0, pE1, ws, kE0, kE1, k00, k01, k10, k11;
    var ca0, ca1, w0, w1, e, kc0, ka0, kc1, ka1, psi0, psi1, agg, bs, art;

    x   <$ dt;
    rho <$ dt;
    h   <- g ^ x;
    cc  <- com h zero rho;
    corr <@ A.corrupt();
    g0 <$ dbool; g1 <$ dbool;
    ls <$ [0 .. 1];
    ns <$ dmat;
    pEc0 <$ dbool; pH0 <$ dbool; pEc1 <$ dbool; pH1 <$ dbool;
    pEh0 <$ dbool; pEh1 <$ dbool;
    tau <$ dbool;
    tv <- tvals ns;
    u0 <- if ls = 0 then ucar tau tv else (cn, cn);
    u1 <- if ls = 1 then ucar tau tv else (cn, cn);
    es <- chal_of g0 g1;
    (qE0, kF0) <@ PartE0.gen(h, u0, es);
    (qH0, kH0) <@ PartH.gen(h, pH0);
    (qE1, kF1) <@ PartE0.gen(h, u1, es);
    (qH1, kH1) <@ PartH.gen(h, pH1);
    q00 <- if g0 then qH0 else qE0;  q01 <- if g0 then qE0 else qH0;
    q10 <- if g1 then qH1 else qE1;  q11 <- if g1 then qE1 else qH1;
    ch <@ A.choose((h, (q00, q01), (q10, q11)),
                   if corr.`1 then Some (if g0 then pH0 else pEc0, if g0 then pEc0 else pH0) else None,
                   if corr.`2 then Some (if g1 then pH1 else pEc1, if g1 then pEc1 else pH1) else None);
    pE0 <- if corr.`1 then pEc0 else pEh0;
    pE1 <- if corr.`2 then pEc1 else pEh1;
    ws  <- pget (pE0, pE1) ls ^^ tau;
    kE0 <- (pE0, shiftr kF0.`2 rho pE0 u0, kF0.`3);
    kE1 <- (pE1, shiftr kF1.`2 rho pE1 u1, kF1.`3);
    k00 <- if g0 then kH0 else kE0;  k01 <- if g0 then kE0 else kH0;
    k10 <- if g1 then kH1 else kE1;  k11 <- if g1 then kE1 else kH1;
    ca0 <- ccoin corr.`1 ch.`1 g0;
    ca1 <- ccoin corr.`2 ch.`2 g1;
    w0  <- omega b corr.`1 ch.`1;
    w1  <- omega b corr.`2 ch.`2;
    e   <- chal_of ca0 ca1;
    kc0 <- if ca0 then k01 else k00;  ka0 <- if ca0 then k00 else k01;
    kc1 <- if ca1 then k11 else k10;  ka1 <- if ca1 then k10 else k11;
    psi0 <- kc0.`1 ^^ w0;
    psi1 <- kc1.`1 ^^ w1;
    agg <- ((Tstar ns 0, aggr kc0 kc1 psi0 psi1 0),
            (Tstar ns 1, aggr kc0 kc1 psi0 psi1 1));
    bs <@ A.guess(tinfo_of ca0 psi0 kc0 ka0 e, tinfo_of ca1 psi1 kc1 ka1 e, agg,
                  view_of corr.`1 ca0 psi0 ch.`1.`1 ka0,
                  view_of corr.`2 ca1 psi1 ch.`2.`1 ka1);
    art <$ dbiased (artp corr);
    return (contf b corr ch g0 g1 ls ws ns art, bs);
  }
}.

(* -------------------------------------------------------------------- *)
(* Final decision of B (and of G_priv): output b* = b if the event       *)
(* holds, a uniform bit otherwise.                                      *)
module type Body = {
  proc body(b : bool) : bool * bool
}.

module Dec (BD : Body) = {
  proc main() : bool = {
    var b, c, bs, r;

    b <$ dbool;
    (c, bs) <@ BD.body(b);
    if (c) { r <- (bs = b); } else { r <$ dbool; }
    return r;
  }
}.

module Obs (BD : Body) = {
  proc main() : bool * bool * bool = {
    var b, c, bs;

    b <$ dbool;
    (c, bs) <@ BD.body(b);
    return (c, bs, b);
  }
}.

module Dec2 (BD : Body) = {
  proc main() : bool * bool = {
    var o, r;

    o <@ Obs(BD).main();
    if (o.`1) { r <- (o.`2 = o.`3); } else { r <$ dbool; }
    return (r, o.`1);
  }
}.

lemma dec_obs (BD <: Body) &m :
    Pr[Dec(BD).main() @ &m : res]
  = Pr[Obs(BD).main() @ &m : res.`1 /\ res.`2 = res.`3]
    + Pr[Obs(BD).main() @ &m : !res.`1] / 2%r.
proof.
have -> : Pr[Dec(BD).main() @ &m : res] = Pr[Dec2(BD).main() @ &m : res.`1].
+ byequiv (: ={glob BD} ==> res{1} = res{2}.`1) => //; proc; inline Obs(BD).main.
  seq 2 3 : (={b, c, bs} /\ o{2} = (c, bs, b){2}); first by wp; call (: true); auto.
  by if => //; auto => /> /#.
rewrite Pr[mu_split res.`2].
have -> : Pr[Dec2(BD).main() @ &m : res.`1 /\ res.`2]
        = Pr[Obs(BD).main() @ &m : res.`1 /\ res.`2 = res.`3].
+ byequiv (: ={glob BD} ==> res{1}.`1 /\ res{1}.`2 <=> res{2}.`1 /\ res{2}.`2 = res{2}.`3) => //.
  proc*; inline Dec2(BD).main; wp.
  seq 1 1 : (o{1} = r{2}); first by call (: ={glob BD} ==> ={res}); [sim | auto].
  if{1}; [by auto | by rnd{1}; auto => />].
have -> : Pr[Dec2(BD).main() @ &m : res.`1 /\ !res.`2]
        = Pr[Obs(BD).main() @ &m : !res.`1] / 2%r.
+ byphoare (: (glob BD) = (glob BD){m} ==> res.`1 /\ !res.`2) => //.
  proc.
  seq 1 : (!o.`1) (Pr[Obs(BD).main() @ &m : !res.`1]) (1%r / 2%r) _ 0%r => //.
  + call (: (glob BD) = (glob BD){m} ==> !res.`1) => //.
    bypr => &h; split; 1: by rewrite Pr[mu_ge0].
    by move=> hg; byequiv (: ={glob BD} ==> ={res}) => //; sim.
  + rcondf 1; 1: by auto.
    rnd (pred1 true); skip => />; rewrite dbool1E; smt().
  + by hoare; if; auto => /> /#.
  by smt().
qed.

(* -------------------------------------------------------------------- *)
(* The guesses succeed with probability kappa0 = 1/648, whatever the    *)
(* adversary did, as long as at most phi = 1 voter is corrupted.        *)
op kappa0 : real = 1%r / 648%r.

op gok (b : bool) (corr : bool * bool) (ch : choice * choice) (g0 g1 : bool)
       (ls : int) (ws : bool) (ns : mat) (art : bool) : bool =
     (corr.`1 => ch.`1.`1 = g0) /\ (corr.`2 => ch.`2.`1 = g1)
  /\ (!(pget corr ls) /\ omega b false (pget ch ls) = ws)
  /\ nmat (omega b corr.`1 ch.`1) (omega b corr.`2 ch.`2) = ns
  /\ art.

lemma contf_gok b corr ch g0 g1 ls ws ns art :
  contf b corr ch g0 g1 ls ws ns art = (sidec corr ch /\ gok b corr ch g0 g1 ls ws ns art).
proof. by rewrite /contf /gok; smt(). qed.

module Guess = {
  proc run(b : bool, corr : bool * bool, ch : choice * choice) : bool = {
    var gm0, gm1, ls, ws, ns, art;

    gm0 <$ dbool;
    gm1 <$ dbool;
    ls  <$ [0 .. 1];
    ws  <$ dbool;
    ns  <$ dmat;
    art <$ dbiased (artp corr);
    return gok b corr ch gm0 gm1 ls ws ns art;
  }
}.

op pg (c : bool) : real = if c then 1%r / 2%r else 1%r.
op pls (corr : bool * bool) : real = (b2r (!corr.`1) + b2r (!corr.`2)) / 2%r.

lemma mu1_dmat (n : mat) :
  0 <= n.`1.`1 <= 2 => 0 <= n.`1.`2 <= 2 => 0 <= n.`2.`1 <= 2 => 0 <= n.`2.`2 <= 2 =>
  mu1 dmat n = 1%r / 81%r.
proof.
case: n => [[a b] [c d]] /= ha hb hc hd.
by rewrite /dmat !dprod1E !dinter1E ha hb hc hd /=.
qed.

lemma nmat_rg w0 w1 :
  let n = nmat w0 w1 in
  0 <= n.`1.`1 <= 2 /\ 0 <= n.`1.`2 <= 2 /\ 0 <= n.`2.`1 <= 2 /\ 0 <= n.`2.`2 <= 2.
proof. by rewrite /nmat /b2n; case: w0; case: w1. qed.

lemma guess_pr b0 (corr0 : bool * bool) (ch0 : choice * choice) : !(corr0.`1 /\ corr0.`2) =>
  phoare [Guess.run : b = b0 /\ corr = corr0 /\ ch = ch0 ==> res] = kappa0.
proof.
move=> hc; proc.
seq 1 : (corr0.`1 => ch0.`1.`1 = gm0) (pg corr0.`1)
        (pg corr0.`2 * (pls corr0 * (1%r / 2%r) * (1%r / 81%r * artp corr0))) _ 0%r
        (b = b0 /\ corr = corr0 /\ ch = ch0) => //.
+ by auto.
+ rnd (fun g => corr0.`1 => ch0.`1.`1 = g); skip => />.
  rewrite dboolE /pg /=; case: (corr0.`1) => //=; smt().
+ seq 1 : (corr0.`2 => ch0.`2.`1 = gm1) (pg corr0.`2)
          (pls corr0 * (1%r / 2%r) * (1%r / 81%r * artp corr0)) _ 0%r
          (b = b0 /\ corr = corr0 /\ ch = ch0 /\ (corr0.`1 => ch0.`1.`1 = gm0)) => //.
  + by auto.
  + rnd (fun g => corr0.`2 => ch0.`2.`1 = g); skip => />.
    rewrite dboolE /pg /=; case: (corr0.`2) => //=; smt().
  + seq 2 : (!(pget corr0 ls) /\ omega b0 false (pget ch0 ls) = ws) (pls corr0 * (1%r / 2%r))
            (1%r / 81%r * artp corr0) _ 0%r
            (b = b0 /\ corr = corr0 /\ ch = ch0 /\ (corr0.`1 => ch0.`1.`1 = gm0)
             /\ (corr0.`2 => ch0.`2.`1 = gm1)) => //.
    + by auto.
    + seq 1 : (!(pget corr0 ls)) (pls corr0) (1%r / 2%r) _ 0%r
              (b = b0 /\ corr = corr0 /\ ch = ch0) => //.
      + by auto.
      + rnd (fun l => !(pget corr0 l)); skip => /> &hr _ _.
        rewrite dinterE /= (range_ltn 0 2) // (range_ltn 1 2) // range_geq //= /pls /pget.
        by case: corr0 hc => c0 c1 /=; case: c0; case: c1 => //= _; rewrite /max /b2r /=.
      + rnd (pred1 (omega b0 false (pget ch0 ls))); skip => /> &hr _.
        by rewrite dbool1E; smt().
      by hoare; auto => />.
    + seq 1 : (nmat (omega b0 corr0.`1 ch0.`1) (omega b0 corr0.`2 ch0.`2) = ns) (1%r / 81%r)
              (artp corr0) _ 0%r
              (b = b0 /\ corr = corr0 /\ ch = ch0 /\ (corr0.`1 => ch0.`1.`1 = gm0)
               /\ (corr0.`2 => ch0.`2.`1 = gm1)
               /\ (!(pget corr0 ls) /\ omega b0 false (pget ch0 ls) = ws)) => //.
      + by auto.
      + rnd (pred1 (nmat (omega b0 corr0.`1 ch0.`1) (omega b0 corr0.`2 ch0.`2))); skip => />.
        have := nmat_rg (omega b0 corr0.`1 ch0.`1) (omega b0 corr0.`2 ch0.`2) => /= [#] *.
        by rewrite mu1_dmat.
      + rnd (pred1 true); skip => /> &hr *.
        split; 2: by move=> _ v _ ->.
        by rewrite dbiased1E /artp /clamp; case: (! corr0.`1 /\ ! corr0.`2) => _ /=; smt().
      by hoare; auto => /> /#.
    by hoare; auto => /> /#.
  by hoare; auto => /> /#.
by hoare; auto => /> /#.
move=> &hr _; rewrite /pg /pls /artp /kappa0 /b2r.
by case: corr0 hc => c0 c1 /=; case: c0; case: c1 => //= _; field.
qed.

(* G_priv as a Body, and G_priv run before the guesses.                 *)
module GB (A : PAdv) : Body = {
  proc body(b : bool) : bool * bool = {
    var o;

    o <@ GPriv(A).body(b);
    return (sidec o.`1 o.`2, o.`4);
  }
}.

module OG (A : PAdv) = {
  proc main() : out_t * bool = {
    var b, o;

    b <$ dbool;
    o <@ GPriv(A).body(b);
    return (o, b);
  }
}.

module RE4 (A : PAdv) = {
  proc main() : bool * bool * bool = {
    var ob, gk;

    ob <@ OG(A).main();
    gk <@ Guess.run(ob.`2, ob.`1.`1, ob.`1.`2);
    return (sidec ob.`1.`1 ob.`1.`2 /\ gk, ob.`1.`4, ob.`2);
  }
}.

(* IND-CPA with a random challenge bit, and the "random world" of DDH.  *)
module CPAR (A : PAdv) = {
  proc main() : bool = {
    var bt, r;

    bt <$ dbool;
    r  <@ CPA(A).main(bt);
    return (r = bt);
  }
}.

module Ind (A : PAdv) = {
  proc main() : bool = {
    var x, y, z, r, bt;

    x  <$ dt;
    y  <$ dt;
    z  <$ dt;
    r  <@ B(A).run(g ^ x, (g ^ y, g ^ z));
    bt <$ dbool;
    return (r = bt);
  }
}.

section Privacy.

declare module A <: PAdv.
declare axiom A_corrupt_ll : islossless A.corrupt.
declare axiom A_choose_ll  : islossless A.choose.
declare axiom A_guess_ll   : islossless A.guess.
declare axiom two_ne0 : two <> zero.

equiv B1_RealG : B1(A).body ~ RealG(A).body :
  ={b, glob A} ==> res{1}.`1 = res{2}.`1 /\ (res{1}.`1 => res{1}.`2 = res{2}.`2).
proof.
proc; inline B(A).body.
seq 19 12 : (={b, glob A, x, h, corr, g0, g1, ls, ns, pE0, pH0, pE1, pH1, ws}
             /\ b0{1} = b{1} /\ cc{1} = com h{1} one rho{1}
             /\ u0{1} = uof 0 ls{1} pE0{1} ws{1} ns{1}
             /\ u1{1} = uof 1 ls{1} pE1{1} ws{1} ns{1}
             /\ es{1} = chal_of g0{1} g1{1} /\ (ls{1} = 0 \/ ls{1} = 1)).
+ wp; rnd; rnd; rnd; rnd; rnd; rnd; rnd; rnd; rnd; call (: true); wp; rnd{1}; rnd.
  skip => /> x _ rho _ g0 _ g1 _ l; rewrite supp_dinter => hl *.
  smt().
exlim rho{1}, u0{1}, u1{1}, es{1}, pE0{1}, pE1{1} => rho0 u00 u10 es0 p0 p1.
seq 4 4 : (={b, glob A, x, h, corr, g0, g1, ls, ns, pE0, pH0, pE1, pH1, ws}
           /\ b0{1} = b{1} /\ rho{1} = rho0 /\ u0{1} = u00 /\ u1{1} = u10 /\ es{1} = es0
           /\ u0{1} = uof 0 ls{1} pE0{1} ws{1} ns{1}
           /\ u1{1} = uof 1 ls{1} pE1{1} ws{1} ns{1}
           /\ es{1} = chal_of g0{1} g1{1} /\ (ls{1} = 0 \/ ls{1} = 1)
           /\ ={qE0, qH0, qE1, qH1, kH0, kH1}
           /\ kE0{1}.`1 = kE0{2}.`1 /\ kE0{2}.`1 = pE0{2}
           /\ kE0{1}.`2 = shiftr kE0{2}.`2 rho0 pE0{2} u00
           /\ (forall e, kE0{1}.`3 e = kE0{2}.`3 es0)
           /\ kE1{1}.`1 = kE1{2}.`1 /\ kE1{2}.`1 = pE1{2}
           /\ kE1{1}.`2 = shiftr kE1{2}.`2 rho0 pE1{2} u10
           /\ (forall e, kE1{1}.`3 e = kE1{2}.`3 es0)).
+ call (: ={h, pi} ==> ={res}); 1: by sim.
  call (partE_H rho0 p1 u10 es0).
  call (: ={h, pi} ==> ={res}); 1: by sim.
  call (partE_H rho0 p0 u00 es0).
  skip => /> &1 &2 *.
  by rewrite !dvu_sum_uof 1,2:two_ne0.
seq 9 9 : (={b, glob A, x, h, corr, g0, g1, ls, ns, pE0, pH0, pE1, pH1, ws}
           /\ b0{1} = b{1} /\ rho{1} = rho0 /\ u0{1} = u00 /\ u1{1} = u10 /\ es{1} = es0
           /\ u0{1} = uof 0 ls{1} pE0{1} ws{1} ns{1}
           /\ u1{1} = uof 1 ls{1} pE1{1} ws{1} ns{1}
           /\ es{1} = chal_of g0{1} g1{1} /\ (ls{1} = 0 \/ ls{1} = 1)
           /\ ={qE0, qH0, qE1, qH1, kH0, kH1}
           /\ kE0{1}.`1 = kE0{2}.`1 /\ kE0{2}.`1 = pE0{2}
           /\ kE0{1}.`2 = shiftr kE0{2}.`2 rho0 pE0{2} u00
           /\ (forall e, kE0{1}.`3 e = kE0{2}.`3 es0)
           /\ kE1{1}.`1 = kE1{2}.`1 /\ kE1{2}.`1 = pE1{2}
           /\ kE1{1}.`2 = shiftr kE1{2}.`2 rho0 pE1{2} u10
           /\ (forall e, kE1{1}.`3 e = kE1{2}.`3 es0)
           /\ ={ch, q00, q01, q10, q11}
           /\ k00{1} = (if g0{1} then kH0{1} else kE0{1}) /\ k01{1} = (if g0{1} then kE0{1} else kH0{1})
           /\ k10{1} = (if g1{1} then kH1{1} else kE1{1}) /\ k11{1} = (if g1{1} then kE1{1} else kH1{1})
           /\ k00{2} = (if g0{2} then kH0{2} else kE0{2}) /\ k01{2} = (if g0{2} then kE0{2} else kH0{2})
           /\ k10{2} = (if g1{2} then kH1{2} else kE1{2}) /\ k11{2} = (if g1{2} then kE1{2} else kH1{2})).
+ call (: true); wp; skip => /> &1 &2 *.
  by case: (g0{2}); case: (g1{2}) => /=; smt().
case (contf b{1} corr{1} ch{1} g0{1} g1{1} ls{1} ws{1} ns{1} true).
+ wp; rnd; call (: true); wp; skip => /> &1 &2 hls hE01 hE02 hE03 hE11 hE12 hE13 hc2 hsc hg0 hg1 hlsh.
  have ca0 : ccoin corr{2}.`1 ch{2}.`1 g0{2} = g0{2} by rewrite /ccoin; smt().
  have ca1 : ccoin corr{2}.`2 ch{2}.`2 g1{2} = g1{2} by rewrite /ccoin; smt().
  rewrite ca0 ca1 !ifif hE01 hE11 /tinfo_of /= hE03 hE13 /=.
  rewrite !Tstar_nmat //=.
  have hw := pget_omega b{2} corr{2} ch{2} ls{2} hls hlsh.
  rewrite !(aggr_shift kE0{1} kE1{1} kE0{2} kE1{2} _ _ rho0
              (uof 0 ls{2} kE0{2}.`1 (omega b{2} false (pget ch{2} ls{2}))
                 (nmat (omega b{2} corr{2}.`1 ch{2}.`1) (omega b{2} corr{2}.`2 ch{2}.`2)))
              (uof 1 ls{2} kE1{2}.`1 (omega b{2} false (pget ch{2} ls{2}))
                 (nmat (omega b{2} corr{2}.`1 ch{2}.`1) (omega b{2} corr{2}.`2 ch{2}.`2)))) //.
  rewrite (routed_zero kE0{2}.`1 kE1{2}.`1 (omega b{2} corr{2}.`1 ch{2}.`1)
            (omega b{2} corr{2}.`2 ch{2}.`2) ls{2} (omega b{2} false (pget ch{2} ls{2})) 0)
          ?two_ne0 //.
  rewrite (routed_zero kE0{2}.`1 kE1{2}.`1 (omega b{2} corr{2}.`1 ch{2}.`1)
            (omega b{2} corr{2}.`2 ch{2}.`2) ls{2} (omega b{2} false (pget ch{2} ls{2})) 1)
          ?two_ne0 //.
  by split; ring.
wp; rnd; call{1} A_guess_ll; call{2} A_guess_ll; wp.
skip => /> &1 &2 hls hE01 hE02 hE03 hE11 hE12 hE13 hK r0 r1 art _ c1 c2 c3 c4 c5 c6 c7 c8.
by move: hK; rewrite /contf /=; smt().
qed.

equiv PartH_eq : PartH.gen ~ PartH.gen : ={h, pi} ==> ={res}.
proof. by sim. qed.

equiv PartH_eqp (p0 : bool) : PartH.gen ~ PartH.gen :
  ={h, pi} /\ pi{1} = p0 ==> ={res} /\ res{1}.`2.`1 = p0.
proof. by proc; auto. qed.

equiv RealG_G2 : RealG(A).body ~ RealG2(A).body : ={b, glob A} ==> ={res}.
proof.
proc.
seq 7 7 : (={b, glob A, x, h, corr, g0, g1, ls, ns}).
+ by auto; call (: true); auto.
seq 17 9 : (={b, glob A, x, h, corr, g0, g1, ls, ns, ws,
              q00, q01, q10, q11, k00, k01, k10, k11}).
+ case (g0{1}); case (g1{1}).
  + swap{1} 1 1; swap{1} 3 1; swap{1} 6 1; swap{1} 8 1.
    wp; do 4! call PartH_eq; auto => /> /#.
  + swap{1} 1 1; swap{1} 6 1.
    wp; do 4! call PartH_eq; auto => /> /#.
  + swap{1} 3 1; swap{1} 8 1.
    wp; do 4! call PartH_eq; auto => /> /#.
  wp; do 4! call PartH_eq; auto => /> /#.
seq 3 3 : (={b, glob A, x, h, corr, g0, g1, ls, ns, ws,
             q00, q01, q10, q11, k00, k01, k10, k11, ch, ca0, ca1}); last by sim.
by wp; call (: true); skip => />; smt().
qed.

equiv RealG2_E : RealG2(A).body ~ RealE(A).body : ={b, glob A} ==> ={res}.
proof.
proc; inline GPriv(A).body.
swap{1} 3 -2; swap{1} [6..7] 23; swap{1} 10 20; swap{1} [4..5] 9.
seq 1 2 : (={b, glob A, corr} /\ b0{2} = b{2}); first by wp; call (: true); auto.
seq 11 11 : (={b, glob A, corr, x, h, p00, p01, p10, p11, q00, q01, q10, q11, k00, k01, k10, k11, ch}
             /\ b0{2} = b{2}).
+ call (: true).
  seq 6 6 : (={b, glob A, corr, x, h, p00, p01, p10, p11} /\ b0{2} = b{2}); first by auto.
  exlim p00{1}, p01{1}, p10{1}, p11{1} => p0 p1 p2 p3.
  call (PartH_eqp p3); call (PartH_eqp p2); call (PartH_eqp p1); call (PartH_eqp p0).
  by skip => />.
case (corr{1}.`1); case (corr{1}.`2).
+ rcondt{1} 3; 1: by auto.
  rcondt{1} 4; 1: by auto.
  rcondt{2} 1; 1: by auto.
  rcondt{2} 2; 1: by auto.
  swap{1} [1..2] 13.
  wp; rnd; rnd; rnd; rnd; rnd; rnd; wp; call (: true); auto => />.
+ rcondt{1} 3; 1: by auto.
  rcondf{1} 4; 1: by auto.
  rcondt{2} 1; 1: by auto.
  rcondf{2} 2; 1: by auto.
  swap{1} 2 1; swap{1} 1 14.
  wp; rnd; rnd; rnd; rnd; rnd{2}; rnd; wp; call (: true); wp; rnd; wp; skip => />.
  by move=> *; rewrite /contf /= /#.
+ rcondf{1} 3; 1: by auto.
  rcondt{1} 4; 1: by auto.
  rcondf{2} 1; 1: by auto.
  rcondt{2} 3; 1: by auto.
  swap{1} 2 13.
  wp; rnd; rnd; rnd; rnd; rnd; rnd{2}; wp; call (: true); wp; rnd; wp; skip => />.
  by move=> *; rewrite /contf /= /#.
rcondf{1} 3; 1: by auto.
rcondf{1} 4; 1: by auto.
rcondf{2} 1; 1: by auto.
rcondf{2} 3; 1: by auto.
swap{1} 2 1.
wp; rnd; rnd; rnd; rnd; rnd{2}; rnd{2}; wp; call (: true); wp; rnd; wp; rnd; wp; skip => />.
by move=> *; rewrite /contf /= /#.
qed.

equiv PartE0_eq : PartE0.gen ~ PartE0.gen : ={h, u, es} ==> ={res}.
proof. by sim. qed.

(* (b): in B0L the view and Cont do not depend on b.                     *)
equiv B0L_swap : B0L(A).body ~ B0L(A).body :
  b{2} = !b{1} /\ ={glob A} ==> res{1}.`1 = res{2}.`1 /\ (res{1}.`1 => res{1}.`2 = res{2}.`2).
proof.
proc.
seq 27 27 : (b{2} = !b{1} /\ ={glob A, x, rho, h, cc, corr, g0, g1, ls, ns, pEc0, pH0, pEc1, pH1,
             tau, tv, u0, u1, es, qE0, kF0, qH0, kH0, qE1, kF1, qH1, kH1, ch}
             /\ (ls{1} = 0 \/ ls{1} = 1)
             /\ u0{1} = (if ls{1} = 0 then ucar tau{1} (tvals ns{1}) else (cn, cn))
             /\ u1{1} = (if ls{1} = 1 then ucar tau{1} (tvals ns{1}) else (cn, cn))).
+ call (: true); wp; call PartH_eq; call PartE0_eq; call PartH_eq; call PartE0_eq.
  wp; do 9! rnd; call (: true); auto => /> *.
  smt(supp_dinter).
seq 2 2 : (b{2} = !b{1} /\ ={glob A, x, rho, h, cc, corr, g0, g1, ls, ns, pEc0, pH0, pEc1, pH1,
             tau, tv, u0, u1, es, qE0, kF0, qH0, kH0, qE1, kF1, qH1, kH1, ch}
           /\ pEh0{2} = pEh0{1} ^^ (ch{1}.`1.`1 ^^ ch{1}.`1.`2)
           /\ pEh1{2} = pEh1{1} ^^ (ch{1}.`2.`1 ^^ ch{1}.`2.`2)
           /\ (ls{1} = 0 \/ ls{1} = 1)
           /\ u0{1} = (if ls{1} = 0 then ucar tau{1} (tvals ns{1}) else (cn, cn))
           /\ u1{1} = (if ls{1} = 1 then ucar tau{1} (tvals ns{1}) else (cn, cn))).
+ rnd (fun p => p ^^ (ch{1}.`2.`1 ^^ ch{1}.`2.`2)) (fun p => p ^^ (ch{1}.`2.`1 ^^ ch{1}.`2.`2)).
  rnd (fun p => p ^^ (ch{1}.`1.`1 ^^ ch{1}.`1.`2)) (fun p => p ^^ (ch{1}.`1.`1 ^^ ch{1}.`1.`2)).
  by skip => />; rewrite /(^^); smt().
seq 21 21 : (b{2} = !b{1} /\ ={glob A, corr, ch, g0, g1, ls, ns, tau, kH0, kH1, kF0, kF1, u0, u1, rho}
             /\ (ls{1} = 0 \/ ls{1} = 1)
             /\ (forall a, contf b{1} corr{1} ch{1} g0{1} g1{1} ls{1} ws{1} ns{1} a
                         = contf b{2} corr{2} ch{2} g0{2} g1{2} ls{2} ws{2} ns{2} a)
             /\ (contf b{1} corr{1} ch{1} g0{1} g1{1} ls{1} ws{1} ns{1} true =>
                   ={ca0, ca1, e, psi0, psi1, ka0, ka1, agg}
                /\ kc0{1}.`3 = kc0{2}.`3 /\ kc1{1}.`3 = kc1{2}.`3)).
+ wp; skip => /> &1 &2 hls.
  split; 1: by move=> a; apply cont_flip.
  move=> hsc hcnt hg0 hg1 hc hws.
  have ca0 : ccoin corr{2}.`1 ch{2}.`1 g0{2} = g0{2} by rewrite /ccoin; smt().
  have ca1 : ccoin corr{2}.`2 ch{2}.`2 g1{2} = g1{2} by rewrite /ccoin; smt().
  have hw1 : pget (omega b{1} corr{2}.`1 ch{2}.`1, omega b{1} corr{2}.`2 ch{2}.`2) ls{2}
           = pget (if corr{2}.`1 then pEc0{2} else pEh0{1},
                   if corr{2}.`2 then pEc1{2} else pEh1{1}) ls{2} ^^ tau{2}.
  + by rewrite pget_omega // hws.
  have hw2 : pget (omega (!b{1}) corr{2}.`1 ch{2}.`1, omega (!b{1}) corr{2}.`2 ch{2}.`2) ls{2}
           = pget (if corr{2}.`1 then pEc0{2} else pEh0{1} ^^ (ch{2}.`1.`1 ^^ ch{2}.`1.`2),
                   if corr{2}.`2 then pEc1{2} else pEh1{1} ^^ (ch{2}.`2.`1 ^^ ch{2}.`2.`2)) ls{2}
             ^^ tau{2}.
  + move: hw1 hc; case: hls => -> /=; rewrite /pget /= /omega /(^^) => hw1 hc;
    rewrite hc /=; move: hw1; rewrite hc /=; case: (b{1}) => /=; smt().
  have hn2 : nmat (omega (!b{1}) corr{2}.`1 ch{2}.`1) (omega (!b{1}) corr{2}.`2 ch{2}.`2)
           = nmat (omega b{1} corr{2}.`1 ch{2}.`1) (omega b{1} corr{2}.`2 ch{2}.`2).
  + by apply sidec_nmat; rewrite /sidec hcnt.
  rewrite ca0 ca1 !ifif /=.
  rewrite (aggr_K _ _ _ _ _ _ _ _ _ _ _ _ 0 two_ne0 _ hls hw1) //.
  rewrite (aggr_K _ _ _ _ _ _ _ _ _ _ _ _ 1 two_ne0 _ hls hw1) //.
  rewrite -!hn2.
  rewrite (aggr_K _ _ _ _ _ _ _ _ _ _ _ _ 0 two_ne0 _ hls hw2) //.
  rewrite (aggr_K _ _ _ _ _ _ _ _ _ _ _ _ 1 two_ne0 _ hls hw2) //.
  by rewrite !psi_flip.
case (contf b{1} corr{1} ch{1} g0{1} g1{1} ls{1} ws{1} ns{1} true).
+ wp; rnd; call (: true); skip => /> &1 &2 hls hc hK hsc hcnt hg0 hg1 hlc2.
  have hKK : contf b{1} corr{2} ch{2} g0{2} g1{2} ls{2} (omega b{1} false (pget ch{2} ls{2}))
               (nmat (omega b{1} corr{2}.`1 ch{2}.`1) (omega b{1} corr{2}.`2 ch{2}.`2)) true.
  + by rewrite /contf /sidec /=; smt().
  move: (hK hKK) => [#] -> -> -> -> -> -> -> -> h3 h4.
  rewrite /tinfo_of h3 h4 /=.
  by move=> *; rewrite hc.
wp; rnd; call{1} A_guess_ll; call{2} A_guess_ll; skip => /> &1 &2 hls hc hK hnK r0 r1 a _.
split; 1: by rewrite hc.
by move=> *; move: hnK; rewrite /contf /sidec /=; smt().
qed.

equiv B0E_B0L : B0E(A).body ~ B0L(A).body : ={b, glob A} ==> ={res}.
proof. by proc; swap{1} [14..15] 14; sim. qed.

equiv B0_B0E : B0(A).body ~ B0E(A).body : ={b, glob A} ==> ={res}.
proof.
proc; inline B(A).body.
seq 10 9 : (={b, glob A, x, rho, h, cc, corr, g0, g1, ls, ns} /\ b0{1} = b{1}
             /\ cc{1} = com h{1} zero rho{1} /\ (ls{1} = 0 \/ ls{1} = 1)).
+ wp; do 4! rnd; call (: true); wp; rnd; rnd; skip => /> *.
  smt(supp_dinter).
seq 5 7 : (={b, glob A, x, rho, h, cc, corr, g0, g1, ls, ns} /\ b0{1} = b{1}
             /\ cc{1} = com h{1} zero rho{1} /\ (ls{1} = 0 \/ ls{1} = 1)
             /\ ={pH0, pH1}
             /\ pE0{1} = (if corr{1}.`1 then pEc0{2} else pEh0{2})
             /\ pE1{1} = (if corr{1}.`2 then pEc1{2} else pEh1{2})
             /\ tau{2} = pget (pE0{1}, pE1{1}) ls{1} ^^ ws{1}).
+ case (corr{1}.`1); case (corr{1}.`2).
  + rnd (fun w => pget (pE0{1}, pE1{1}) ls{1} ^^ w) (fun t => pget (pE0{1}, pE1{1}) ls{1} ^^ t).
    rnd{2}; rnd{2}; do 4! rnd; skip => />; rewrite /(^^); smt().
  + swap{2} 6 -3; swap{2} 4 1.
    rnd (fun w => pget (pE0{1}, pE1{1}) ls{1} ^^ w) (fun t => pget (pE0{1}, pE1{1}) ls{1} ^^ t).
    rnd{2}; rnd{2}; do 4! rnd; skip => />; rewrite /(^^); smt().
  + swap{2} 5 -4; swap{2} 2 3.
    rnd (fun w => pget (pE0{1}, pE1{1}) ls{1} ^^ w) (fun t => pget (pE0{1}, pE1{1}) ls{1} ^^ t).
    rnd{2}; rnd{2}; do 4! rnd; skip => />; rewrite /(^^); smt().
  swap{2} 1 5; swap{2} 2 4; swap{2} 3 -2; swap{2} 4 -1.
  rnd (fun w => pget (pE0{1}, pE1{1}) ls{1} ^^ w) (fun t => pget (pE0{1}, pE1{1}) ls{1} ^^ t).
  rnd{2}; rnd{2}; do 4! rnd; skip => />; rewrite /(^^); smt().
seq 4 4 : (={b, glob A, x, rho, h, cc, corr, g0, g1, ls, ns, pH0, pH1, tv, u0, u1, es}
           /\ b0{1} = b{1} /\ cc{1} = com h{1} zero rho{1} /\ (ls{1} = 0 \/ ls{1} = 1)
           /\ pE0{1} = (if corr{1}.`1 then pEc0{2} else pEh0{2})
           /\ pE1{1} = (if corr{1}.`2 then pEc1{2} else pEh1{2})
           /\ tau{2} = pget (pE0{1}, pE1{1}) ls{1} ^^ ws{1}
           /\ u0{1} = uof 0 ls{1} pE0{1} ws{1} ns{1}
           /\ u1{1} = uof 1 ls{1} pE1{1} ws{1} ns{1}).
+ wp; skip => /> &1 &2 hls; rewrite /uof /pget /=.
  by case: hls => -> /=.
exlim rho{1}, pE0{1}, pE1{1}, u0{1}, u1{1}, pH0{1}, pH1{1} => r0 p0 p1 v0 v1 ph0 ph1.
seq 4 4 : (={b, glob A, x, rho, h, cc, corr, g0, g1, ls, ns, pH0, pH1, tv, u0, u1, es}
           /\ b0{1} = b{1} /\ rho{1} = r0 /\ pE0{1} = p0 /\ pE1{1} = p1 /\ u0{1} = v0 /\ u1{1} = v1
           /\ pE0{1} = (if corr{1}.`1 then pEc0{2} else pEh0{2})
           /\ pE1{1} = (if corr{1}.`2 then pEc1{2} else pEh1{2})
           /\ tau{2} = pget (pE0{1}, pE1{1}) ls{1} ^^ ws{1}
           /\ ={qE0, qH0, qE1, qH1, kH0, kH1}
           /\ kE0{1} = (p0, shiftr kF0{2}.`2 r0 p0 v0, kF0{2}.`3)
           /\ kE1{1} = (p1, shiftr kF1{2}.`2 r0 p1 v1, kF1{2}.`3)
           /\ kH0{1}.`1 = pH0{1} /\ kH1{1}.`1 = pH1{1}).
+ call (PartH_eqp ph1); call (partE_E0 r0 p1 v1); call (PartH_eqp ph0); call (partE_E0 r0 p0 v0).
  skip => /> &1 &2 *.
  split; 1: exact (dvu_sum_uof _ _ _ _ _ two_ne0).
  move=> _ rL rR _ h2 h3 h4.
  split; 1: exact (dvu_sum_uof _ _ _ _ _ two_ne0).
  move=> _ rL1 rR1 _ g2 g3 g4.
  have ef : forall (k : psec) (k' : psec) p r, k.`1 = p => k.`2 = r =>
              (forall e, k.`3 e = k'.`3 e) => k = (p, r, k'.`3).
  + move=> [x1 x2 x3] k' p r /= -> -> he.
    by have -> : x3 = k'.`3 by apply fun_ext => e; apply he.
  by split; apply ef.
seq 9 14 : (b0{1} = b{2} /\ ={glob A, corr, ch, g0, g1, ls, ns, ws, k00, k01, k10, k11}).
+ wp; call (: true); wp; skip => /> &1 &2 *.
  split; 1: by case: (corr{2}.`1) => //=; case: (corr{2}.`2) => //=; smt().
  move=> *; rewrite /(^^) /pget; smt().
by wp; rnd; call (: true); wp; skip => />.
qed.

lemma GPriv_Dec &m : Pr[GPriv(A).main() @ &m : res] = Pr[Dec(GB(A)).main() @ &m : res].
proof.
byequiv => //; proc; inline GB(A).body.
seq 2 4 : (={b, glob A} /\ c{2} = sidec o{1}.`1 o{1}.`2 /\ bs{2} = o{1}.`4).
+ by wp; call (: ={glob A, b} ==> ={res, glob A}); [sim | auto].
by if => //; auto.
qed.

lemma OG_GB (P : bool -> bool -> bool -> bool) &m :
    Pr[OG(A).main() @ &m : P (sidec res.`1.`1 res.`1.`2) res.`1.`4 res.`2]
  = Pr[Obs(GB(A)).main() @ &m : P res.`1 res.`2 res.`3].
proof.
byequiv => //; proc; inline GB(A).body; wp.
by call (: ={glob A, b} ==> ={res, glob A}); [sim | auto].
qed.

lemma RealE_RE4 (P : bool * bool * bool -> bool) &m :
  Pr[Obs(RealE(A)).main() @ &m : P res] = Pr[RE4(A).main() @ &m : P res].
proof.
byequiv => //; proc; inline RealE(A).body RE4(A).main OG(A).main Guess.run.
swap{1} 7 1; wp; do 6! rnd; wp.
call (: ={glob A, b} ==> ={res, glob A}); [sim | auto => />].
by move=> *; rewrite contf_gok.
qed.

lemma RE4_pr1 &m :
    Pr[RE4(A).main() @ &m : res.`1 /\ res.`2 = res.`3]
  = Pr[OG(A).main() @ &m : sidec res.`1.`1 res.`1.`2 /\ res.`1.`4 = res.`2] * kappa0.
proof.
byphoare (: (glob A) = (glob A){m} ==> res.`1 /\ res.`2 = res.`3) => //.
proc.
seq 1 : (sidec ob.`1.`1 ob.`1.`2 /\ ob.`1.`4 = ob.`2) (Pr[OG(A).main() @ &m : sidec res.`1.`1 res.`1.`2 /\ res.`1.`4 = res.`2]) kappa0 _ 0%r => //.
+ call (: (glob A) = (glob A){m} ==> sidec res.`1.`1 res.`1.`2 /\ res.`1.`4 = res.`2) => //.
  bypr => &h; split; 1: by rewrite Pr[mu_ge0].
  by move=> hg; byequiv (: ={glob A} ==> ={res}) => //; sim.
+ exlim ob => ob0.
  case @[ambient] (!(ob0.`1.`1.`1 /\ ob0.`1.`1.`2)) => hc.
  + call (guess_pr ob0.`2 ob0.`1.`1 ob0.`1.`2 hc); skip => /> /#.
  by exfalso => &hr; rewrite /sidec; smt().
+ by hoare; inline Guess.run; auto => /> /#.
qed.

lemma RE4_pr0 &m :
    Pr[RE4(A).main() @ &m : res.`1]
  = Pr[OG(A).main() @ &m : sidec res.`1.`1 res.`1.`2] * kappa0.
proof.
byphoare (: (glob A) = (glob A){m} ==> res.`1) => //.
proc.
seq 1 : (sidec ob.`1.`1 ob.`1.`2) (Pr[OG(A).main() @ &m : sidec res.`1.`1 res.`1.`2]) kappa0 _ 0%r => //.
+ call (: (glob A) = (glob A){m} ==> sidec res.`1.`1 res.`1.`2) => //.
  bypr => &h; split; 1: by rewrite Pr[mu_ge0].
  by move=> hg; byequiv (: ={glob A} ==> ={res}) => //; sim.
+ exlim ob => ob0.
  case @[ambient] (!(ob0.`1.`1.`1 /\ ob0.`1.`1.`2)) => hc.
  + call (guess_pr ob0.`2 ob0.`1.`1 ob0.`1.`2 hc); skip => /> /#.
  by exfalso => &hr; rewrite /sidec; smt().
+ by hoare; inline Guess.run; auto => /> /#.
qed.

lemma GPriv_body_ll : islossless GPriv(A).body.
proof.
proc; call A_guess_ll; wp.
seq 12 : true => //.
+ call A_choose_ll; inline *; auto; call A_corrupt_ll; auto => />.
  smt(dt_ll dbool_ll dprand_ll dprod_ll).
seq 1 : true => //; first by if; auto; smt(dbool_ll).
by if; auto; smt(dbool_ll).
qed.

lemma dmat_ll : is_lossless dmat.
proof. by rewrite /dmat; apply dprod_ll; split; apply dprod_ll; split; rewrite /is_lossless weight_dinter. qed.

lemma dinter01_ll : is_lossless [0 .. 1].
proof. by rewrite /is_lossless weight_dinter. qed.

lemma B_body_ll : islossless B(A).body.
proof.
proc; rnd; call A_guess_ll; wp; call A_choose_ll; inline *; auto; call A_corrupt_ll; auto => />.
smt(dt_ll dbool_ll dprand_ll dprod_ll dmat_ll dinter01_ll dbiased_ll).
qed.

lemma B0L_body_ll : islossless B0L(A).body.
proof.
proc; rnd; call A_guess_ll; wp; rnd; rnd; call A_choose_ll; inline *; auto; call A_corrupt_ll; auto => />.
smt(dt_ll dbool_ll dprand_ll dprod_ll dmat_ll dinter01_ll dbiased_ll).
qed.

lemma RealE_body_ll : islossless RealE(A).body.
proof.
proc; auto; call GPriv_body_ll; auto => />; smt(dbool_ll dmat_ll dinter01_ll dbiased_ll).
qed.

lemma CPA1_Dec &m : Pr[CPA(A).main(true) @ &m : res] = Pr[Dec(B1(A)).main() @ &m : res].
proof.
byequiv => //; proc; inline B(A).run B1(A).body.
swap{2} [1..2] 2.
seq 6 6 : (={b, glob A, bs} /\ cont{1} = c{2}).
+ wp; call (: ={glob A, arg} ==> ={res, glob A}); 1: by sim.
  by auto => />; rewrite /b2e.
by wp; if => //; auto.
qed.

lemma CPA0_Dec &m : Pr[CPA(A).main(false) @ &m : res] = Pr[Dec(B0(A)).main() @ &m : res].
proof.
byequiv => //; proc; inline B(A).run B0(A).body.
swap{2} [1..2] 2.
seq 6 6 : (={b, glob A, bs} /\ cont{1} = c{2}).
+ wp; call (: ={glob A, arg} ==> ={res, glob A}); 1: by sim.
  by auto => />; rewrite /b2e.
by wp; if => //; auto.
qed.

equiv Obs_B1_G : Obs(B1(A)).main ~ Obs(RealG(A)).main :
  ={glob A} ==> res{1}.`1 = res{2}.`1 /\ (res{1}.`1 => ={res}).
proof. by proc; call B1_RealG; auto => /> /#. qed.

equiv Obs_G_G2 : Obs(RealG(A)).main ~ Obs(RealG2(A)).main : ={glob A} ==> ={res}.
proof. by proc; call RealG_G2; auto. qed.

equiv Obs_G2_E : Obs(RealG2(A)).main ~ Obs(RealE(A)).main : ={glob A} ==> ={res}.
proof. by proc; call RealG2_E; auto. qed.

equiv Obs_B0_E : Obs(B0(A)).main ~ Obs(B0E(A)).main : ={glob A} ==> ={res}.
proof. by proc; call B0_B0E; auto. qed.

equiv Obs_E_L : Obs(B0E(A)).main ~ Obs(B0L(A)).main : ={glob A} ==> ={res}.
proof. by proc; call B0E_B0L; auto. qed.

equiv Obs_L_swap : Obs(B0L(A)).main ~ Obs(B0L(A)).main :
  ={glob A} ==> res{1}.`1 = res{2}.`1 /\ (res{1}.`1 => res{1}.`2 = res{2}.`2 /\ res{1}.`3 = !res{2}.`3).
proof. by proc; call B0L_swap; rnd (fun b => !b); auto => /> /#. qed.

(* (a): CPA with beta = 1 reproduces G_priv, damped by kappa0.           *)
lemma cpa1 &m :
  Pr[CPA(A).main(true) @ &m : res] = 1%r / 2%r + kappa0 * (Pr[GPriv(A).main() @ &m : res] - 1%r / 2%r).
proof.
rewrite CPA1_Dec (dec_obs (B1(A))) GPriv_Dec (dec_obs (GB(A))).
have hE1 : Pr[Obs(B1(A)).main() @ &m : res.`1 /\ res.`2 = res.`3]
         = Pr[Obs(GB(A)).main() @ &m : res.`1 /\ res.`2 = res.`3] * kappa0.
+ have -> : Pr[Obs(B1(A)).main() @ &m : res.`1 /\ res.`2 = res.`3]
          = Pr[Obs(RealG(A)).main() @ &m : res.`1 /\ res.`2 = res.`3].
  + by byequiv Obs_B1_G => /#.
  have -> : Pr[Obs(RealG(A)).main() @ &m : res.`1 /\ res.`2 = res.`3]
          = Pr[Obs(RealG2(A)).main() @ &m : res.`1 /\ res.`2 = res.`3] by byequiv Obs_G_G2.
  have -> : Pr[Obs(RealG2(A)).main() @ &m : res.`1 /\ res.`2 = res.`3]
          = Pr[Obs(RealE(A)).main() @ &m : res.`1 /\ res.`2 = res.`3] by byequiv Obs_G2_E.
  rewrite (RealE_RE4 (fun (r : bool * bool * bool) => r.`1 /\ r.`2 = r.`3)) /= RE4_pr1.
  by rewrite (OG_GB (fun c bs b => c /\ bs = b)).
have hE0 : Pr[Obs(B1(A)).main() @ &m : !res.`1]
         = 1%r - Pr[Obs(GB(A)).main() @ &m : res.`1] * kappa0.
+ have -> : Pr[Obs(B1(A)).main() @ &m : !res.`1] = Pr[Obs(RealG(A)).main() @ &m : !res.`1].
  + by byequiv Obs_B1_G => /#.
  have -> : Pr[Obs(RealG(A)).main() @ &m : !res.`1]
          = Pr[Obs(RealG2(A)).main() @ &m : !res.`1] by byequiv Obs_G_G2.
  have -> : Pr[Obs(RealG2(A)).main() @ &m : !res.`1]
          = Pr[Obs(RealE(A)).main() @ &m : !res.`1] by byequiv Obs_G2_E.
  rewrite Pr[mu_not].
  have -> : Pr[Obs(RealE(A)).main() @ &m : true] = 1%r.
  + by byphoare => //; proc; call RealE_body_ll; auto; smt(dbool_ll).
  rewrite (RealE_RE4 (fun (r : bool * bool * bool) => r.`1)) /= RE4_pr0.
  by rewrite (OG_GB (fun c bs b => c)).
have hG0 : Pr[Obs(GB(A)).main() @ &m : !res.`1] = 1%r - Pr[Obs(GB(A)).main() @ &m : res.`1].
+ rewrite Pr[mu_not].
  have -> : Pr[Obs(GB(A)).main() @ &m : true] = 1%r; last done.
  by byphoare => //; proc; inline GB(A).body; wp; call GPriv_body_ll; auto; smt(dbool_ll).
rewrite hE1 hE0 hG0 /kappa0; ring.
qed.

(* (b): CPA with beta = 0 outputs a uniform bit.                        *)
lemma cpa0 &m : Pr[CPA(A).main(false) @ &m : res] = 1%r / 2%r.
proof.
rewrite CPA0_Dec (dec_obs (B0(A))).
have eq : forall (P : bool * bool * bool -> bool),
  Pr[Obs(B0(A)).main() @ &m : P res] = Pr[Obs(B0L(A)).main() @ &m : P res].
+ move=> P.
  have -> : Pr[Obs(B0(A)).main() @ &m : P res] = Pr[Obs(B0E(A)).main() @ &m : P res].
  + by byequiv Obs_B0_E.
  by byequiv Obs_E_L.
rewrite (eq (fun (r : bool * bool * bool) => r.`1 /\ r.`2 = r.`3))
        (eq (fun (r : bool * bool * bool) => !r.`1)) /=.
have hs : Pr[Obs(B0L(A)).main() @ &m : res.`1 /\ res.`2 = res.`3]
        = Pr[Obs(B0L(A)).main() @ &m : res.`1 /\ res.`2 <> res.`3].
+ by byequiv Obs_L_swap => /#.
have hsplit : Pr[Obs(B0L(A)).main() @ &m : res.`1]
            = Pr[Obs(B0L(A)).main() @ &m : res.`1 /\ res.`2 = res.`3]
              + Pr[Obs(B0L(A)).main() @ &m : res.`1 /\ res.`2 <> res.`3].
+ by rewrite Pr[mu_split (res.`2 = res.`3)].
have hn : Pr[Obs(B0L(A)).main() @ &m : !res.`1] = 1%r - Pr[Obs(B0L(A)).main() @ &m : res.`1].
+ rewrite Pr[mu_not].
  have -> : Pr[Obs(B0L(A)).main() @ &m : true] = 1%r; last done.
  by byphoare => //; proc; call B0L_body_ll; auto; smt(dbool_ll).
by rewrite hn hsplit -hs; field.
qed.

lemma B_run_ll : islossless B(A).run.
proof. by proc; seq 2 : true => //; [call B_body_ll; auto; smt(dbool_ll) | if; auto; smt(dbool_ll)]. qed.

lemma CPAR_split &m :
  Pr[CPAR(A).main() @ &m : res]
  = (Pr[CPA(A).main(true) @ &m : res] + Pr[CPA(A).main(false) @ &m : !res]) / 2%r.
proof.
byphoare (: (glob A) = (glob A){m} ==> res) => //.
proc.
seq 1 : bt (1%r / 2%r) (Pr[CPA(A).main(true) @ &m : res])
           (1%r / 2%r) (Pr[CPA(A).main(false) @ &m : !res]) ((glob A) = (glob A){m}) => //.
+ by auto.
+ by rnd; skip => />; rewrite dboolE.
+ call (: (glob A) = (glob A){m} /\ bt = true ==> res) => //.
  + bypr => &h; split; 1: by rewrite Pr[mu_ge0].
    by move=> [hg hb]; byequiv (: ={glob A, arg} ==> ={res}) => //; sim.
  by skip => /> &hr -> /#.
+ by rnd; skip => />; rewrite dboolE.
+ call (: (glob A) = (glob A){m} /\ bt = false ==> !res) => //.
  + bypr => &h; split; 1: by rewrite Pr[mu_ge0].
    by move=> [hg hb]; byequiv (: ={glob A, arg} ==> ={res}) => //; sim.
  by skip => /> &hr hb /#.
smt().
qed.

lemma DDH0_CPAR &m : Pr[DDH0(D(A)).main() @ &m : res] = Pr[CPAR(A).main() @ &m : res].
proof.
byequiv => //; proc; inline D(A).guess CPA(A).main.
swap{1} 6 -5.
wp; call (: ={glob A, arg} ==> ={res}); 1: by sim.
wp; rnd; rnd; wp; rnd; skip => /> bt _ x _ y _.
by rewrite /com expM.
qed.

lemma DDH1_Ind &m : Pr[DDH1(D(A)).main() @ &m : res] = Pr[Ind(A).main() @ &m : res].
proof.
byequiv => //; proc; inline D(A).guess.
swap{1} 7 -6; swap{2} 5 -4.
wp; call (: ={glob A, arg} ==> ={res}); 1: by sim.
wp; rnd (fun z => b2e bt{1} + z) (fun z => z - b2e bt{1}); rnd; rnd; rnd.
skip => /> bt _ x _ y _; split; 1: by move=> z _; ring.
move=> _ z _; split; 1: by ring.
by move=> _; rewrite expD.
qed.

lemma Ind_half &m : Pr[Ind(A).main() @ &m : res] = 1%r / 2%r.
proof.
byphoare => //; proc.
rnd (pred1 r); call B_run_ll; auto => />.
split; 1: by apply dt_ll.
by move=> *; rewrite dbool1E; smt().
qed.

(* -------------------------------------------------------------------- *)
(* Theorem 3, concrete form (n = 2, m = 2, matrix mode, phi = 1):       *)
(*   kappa0 * (Pr[G_priv = 1] - 1/2) = 2 * Adv_DDH(D(A)),                *)
(* with kappa0 = 1/648.                                                  *)
lemma privacy &m :
    kappa0 * (Pr[GPriv(A).main() @ &m : res] - 1%r / 2%r)
  = 2%r * (Pr[DDH0(D(A)).main() @ &m : res] - Pr[DDH1(D(A)).main() @ &m : res]).
proof.
rewrite DDH0_CPAR CPAR_split DDH1_Ind Ind_half cpa1.
have -> : Pr[CPA(A).main(false) @ &m : !res] = 1%r - Pr[CPA(A).main(false) @ &m : res].
+ rewrite Pr[mu_not].
  have -> : Pr[CPA(A).main(false) @ &m : true] = 1%r; last done.
  by byphoare => //; proc; call B_run_ll; auto; smt(dt_ll).
by rewrite cpa0; field.
qed.

lemma privacy_abs &m :
    `|Pr[GPriv(A).main() @ &m : res] - 1%r / 2%r|
  = 1296%r * `|Pr[DDH0(D(A)).main() @ &m : res] - Pr[DDH1(D(A)).main() @ &m : res]|.
proof.
have h := privacy &m.
have -> : Pr[GPriv(A).main() @ &m : res] - 1%r / 2%r
        = 1296%r * (Pr[DDH0(D(A)).main() @ &m : res] - Pr[DDH1(D(A)).main() @ &m : res]).
+ have -> : Pr[GPriv(A).main() @ &m : res] - 1%r / 2%r
          = 648%r * (kappa0 * (Pr[GPriv(A).main() @ &m : res] - 1%r / 2%r)).
  + by rewrite /kappa0; field.
  by rewrite h; ring.
by rewrite RealOrder.normrM RealOrder.ger0_norm.
qed.

end section Privacy.
